    "facts": [
      {
        "textJa": "アハズの使者たちはイザヤのもとへ行きました。",
        "knownBy": {
          "chapter": 19,
          "verse": 5
        },
        "sourceIds": [
          "person-isaiah_617-webp-2ki-19-5"
        ]
      },
      {
        "textJa": "イザヤはヒゼキヤに、主がセンナケリブについて聞いたと伝えました。",
        "knownBy": {
          "chapter": 19,
          "verse": 20
        },
        "sourceIds": [
          "person-isaiah_617-webp-2ki-19-20"
        ]
      },
      {
        "textJa": "そのころイザヤはヒゼキヤに、病気と死について主の言葉を伝えました。",
        "knownBy": {
          "chapter": 20,
          "verse": 1
        },
        "sourceIds": [
          "person-isaiah_617-webp-2ki-20-1"
        ]
      },
      {
        "textJa": "イザヤの指示で干しいちじくの塊が患部に当てられ、ヒゼキヤは回復しました。",
        "knownBy": {
          "chapter": 20,
          "verse": 7
        },
        "sourceIds": [
          "person-isaiah_617-webp-2ki-20-7"
        ]
      }
    ],
