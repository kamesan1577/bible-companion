    "sourceIds": [
      "person-adonijah_97-webp-1ki-1-5",
      "person-adonijah_97-wikipedia"
    ],
    "facts": [
      {
        "textJa": "アドニヤはヨアブと祭司アビヤタルに相談し、二人は彼に協力しました。",
        "knownBy": {
          "chapter": 1,
          "verse": 7
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-7"
        ]
      },
      {
        "textJa": "祭司ザドク、ベナヤ、預言者ナタンらはアドニヤに加わりませんでした。",
        "knownBy": {
          "chapter": 1,
          "verse": 8
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-8"
        ]
      },
      {
        "textJa": "アドニヤはゾヘレテの石のそばでいけにえをささげ、王子たちやユダの家臣を招きました。",
        "knownBy": {
          "chapter": 1,
          "verse": 9
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-9"
        ]
      },
      {
        "textJa": "ナタンはバテ・シェバに、アドニヤが王となったと告げました。",
        "knownBy": {
          "chapter": 1,
          "verse": 11
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-11"
        ]
      },
      {
        "textJa": "バテ・シェバはダビデに、ソロモンを後継者とする約束を確かめるよう求めました。",
        "knownBy": {
          "chapter": 1,
          "verse": 13
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-13"
        ]
      },
      {
        "textJa": "バテ・シェバはダビデに、アドニヤが王となったことを伝えました。",
        "knownBy": {
          "chapter": 1,
          "verse": 18
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-18"
        ]
      },
      {
        "textJa": "ナタンはダビデに、アドニヤを後継者にすると言ったのか尋ねました。",
        "knownBy": {
          "chapter": 1,
          "verse": 24
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-24"
        ]
      },
      {
        "textJa": "ナタンは、アドニヤが宴を開き「王アドニヤ万歳」と唱えさせたと報告しました。",
        "knownBy": {
          "chapter": 1,
          "verse": 25
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-25"
        ]
      },
      {
        "textJa": "アドニヤと宴の客たちは、食事の終わりに町の騒ぎを聞きました。",
        "knownBy": {
          "chapter": 1,
          "verse": 41
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-41"
        ]
      },
      {
        "textJa": "アドニヤは祭司アビヤタルの子ヨナタンを迎え、知らせを尋ねました。",
        "knownBy": {
          "chapter": 1,
          "verse": 42
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-42"
        ]
      },
      {
        "textJa": "ヨナタンは、ダビデがソロモンを王にしたとアドニヤに告げました。",
        "knownBy": {
          "chapter": 1,
          "verse": 43
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-43"
        ]
      },
      {
        "textJa": "アドニヤの客たちは恐れて立ち去りました。",
        "knownBy": {
          "chapter": 1,
          "verse": 49
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-49"
        ]
      },
      {
        "textJa": "アドニヤはソロモンを恐れ、祭壇の角をつかみました。",
        "knownBy": {
          "chapter": 1,
          "verse": 50
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-50"
        ]
      },
      {
        "textJa": "人々は、アドニヤがソロモンに命を助ける誓いを求めて祭壇にいると伝えました。",
        "knownBy": {
          "chapter": 1,
          "verse": 51
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-1-51"
        ]
      },
      {
        "textJa": "アドニヤはバテ・シェバのもとを訪れ、平和な用件だと答えました。",
        "knownBy": {
          "chapter": 2,
          "verse": 13
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-13"
        ]
      },
      {
        "textJa": "バテ・シェバはアドニヤのためにソロモンへ願いを伝えました。",
        "knownBy": {
          "chapter": 2,
          "verse": 19
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-19"
        ]
      },
      {
        "textJa": "バテ・シェバは、アドニヤにシュネム人アビシャグを妻として与えるよう願いました。",
        "knownBy": {
          "chapter": 2,
          "verse": 21
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-21"
        ]
      },
      {
        "textJa": "ソロモンはアビシャグを求める願いを王位の要求と結び付けて受け止めました。",
        "knownBy": {
          "chapter": 2,
          "verse": 22
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-22"
        ]
      },
      {
        "textJa": "ソロモンは、アドニヤが自分の命に関わることを言ったと誓いました。",
        "knownBy": {
          "chapter": 2,
          "verse": 23
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-23"
        ]
      },
      {
        "textJa": "ソロモンはアドニヤをその日に死刑にすると宣言しました。",
        "knownBy": {
          "chapter": 2,
          "verse": 24
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-24"
        ]
      },
      {
        "textJa": "ヨアブはアドニヤに従っていたため、ソロモンの処置を聞いて主の幕屋へ逃れました。",
        "knownBy": {
          "chapter": 2,
          "verse": 28
        },
        "sourceIds": [
          "person-adonijah_97-webp-1ki-2-28"
        ]
      }
    ],
