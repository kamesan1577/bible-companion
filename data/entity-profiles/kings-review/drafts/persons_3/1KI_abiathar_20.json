    "facts": [
      {
        "textJa": "1:42では、祭司アビアタルの子ヨナタンがアドニヤのもとへ知らせを持って来ます。",
        "knownBy": {
          "chapter": 1,
          "verse": 42
        },
        "sourceIds": [
          "person-abiathar_20-webp-1ki-1-42"
        ]
      },
      {
        "textJa": "ソロモンはアビアタルにアナトテの畑へ退くよう命じ、父ダビデとともに苦難を受け、主の箱を担いだことを理由に命を取らないと告げます。",
        "knownBy": {
          "chapter": 2,
          "verse": 26
        },
        "sourceIds": [
          "person-abiathar_20-webp-1ki-2-26"
        ]
      },
      {
        "textJa": "ソロモンはアビアタルを主の祭司職から退けました。",
        "knownBy": {
          "chapter": 2,
          "verse": 27
        },
        "sourceIds": [
          "person-abiathar_20-webp-1ki-2-27"
        ]
      },
      {
        "textJa": "祭司ザドクがアビアタルに代わって任じられます。",
        "knownBy": {
          "chapter": 2,
          "verse": 35
        },
        "sourceIds": [
          "person-abiathar_20-webp-1ki-2-35"
        ]
      },
      {
        "textJa": "ソロモンの役人一覧では、ザドクとアビアタルが祭司として記されています。",
        "knownBy": {
          "chapter": 4,
          "verse": 4
        },
        "sourceIds": [
          "person-abiathar_20-webp-1ki-4-4"
        ]
      }
    ],
