    "facts": [
      {
        "textJa": "エリヤは主の名によって、数年間露も雨も降らないとアハブに告げました。",
        "knownBy": {
          "chapter": 17,
          "verse": 1
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-17-1"
        ]
      },
      {
        "textJa": "エリヤはザレパテのやもめに、まず自分のために小さなパンを作るよう求めました。",
        "knownBy": {
          "chapter": 17,
          "verse": 13
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-17-13"
        ]
      },
      {
        "textJa": "主はエリヤの願いを聞き、子どもは生き返りました。",
        "knownBy": {
          "chapter": 17,
          "verse": 22
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-17-22"
        ]
      },
      {
        "textJa": "エリヤはカルメル山で人々に、主とバアルのどちらに従うのか決めるよう迫りました。",
        "knownBy": {
          "chapter": 18,
          "verse": 21
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-18-21"
        ]
      },
      {
        "textJa": "エリヤはバアルの預言者を捕らえるよう命じ、彼らをキション川へ連れて行きました。",
        "knownBy": {
          "chapter": 18,
          "verse": 40
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-18-40"
        ]
      },
      {
        "textJa": "エリヤは畑で働くエリシャを見つけ、自分の外套を彼に掛けました。",
        "knownBy": {
          "chapter": 19,
          "verse": 19
        },
        "sourceIds": [
          "person-elijah_1131-webp-1ki-19-19"
        ]
      }
    ],
    "modernLocationJa": null,
    "historicalRoleJa": null,
    "coordinate": null,
    "locationNoteJa": null,
