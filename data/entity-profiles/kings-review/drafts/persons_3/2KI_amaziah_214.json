    "facts": [
      {
        "textJa": "アマツヤはイスラエル王ヨアシュの治世第2年に王となりました。",
        "knownBy": {
          "chapter": 14,
          "verse": 1
        },
        "sourceIds": [
          "person-amaziah_214-webp-2ki-14-1"
        ]
      },
      {
        "textJa": "イスラエル王ヨアシュはエルサレムを攻め、城壁の一部を壊し、神殿と王宮の財宝を奪いました。",
        "knownBy": {
          "chapter": 14,
          "verse": 13
        },
        "sourceIds": [
          "person-amaziah_214-webp-2ki-14-13"
        ]
      },
      {
        "textJa": "アマツヤはイスラエル王ヨアシュの死後、15年間生きました。",
        "knownBy": {
          "chapter": 14,
          "verse": 17
        },
