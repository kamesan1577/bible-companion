    "facts": [
      {
        "textJa": "アタルヤは子が死んだと知ると王族を滅ぼそうとしました。",
        "knownBy": {
          "chapter": 11,
          "verse": 1
        },
        "sourceIds": [
          "person-athaliah_359-webp-2ki-11-1"
        ]
      },
      {
        "textJa": "ヨラム王の娘ヨシェバは、アハズヤの子ヨアシュを隠して救いました。",
        "knownBy": {
          "chapter": 11,
          "verse": 2
        },
        "sourceIds": [
          "person-athaliah_359-webp-2ki-11-2"
        ]
      },
      {
        "textJa": "ヨアシュは6年間、主の家でヨシェバとともに隠されていました。",
        "knownBy": {
          "chapter": 11,
          "verse": 3
        },
        "sourceIds": [
          "person-athaliah_359-webp-2ki-11-3"
        ]
      },
      {
        "textJa": "アタルヤは王が柱のそばに立つのを見て衣を裂き、「謀反だ」と叫びました。",
        "knownBy": {
          "chapter": 11,
          "verse": 14
        },
        "sourceIds": [
          "person-athaliah_359-webp-2ki-11-14"
        ]
      },
      {
        "textJa": "アタルヤは剣で殺され、国の人々は喜び、町は静まりました。",
        "knownBy": {
          "chapter": 11,
          "verse": 20
        },
        "sourceIds": [
          "person-athaliah_359-webp-2ki-11-20"
        ]
      }
