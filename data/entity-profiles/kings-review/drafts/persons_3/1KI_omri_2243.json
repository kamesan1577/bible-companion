    "facts": [
      {
        "textJa": "オムリはイスラエルの民とともにギベトンを包囲していた陣からサマリアへ進みました。",
        "knownBy": {
          "chapter": 16,
          "verse": 17
        },
        "sourceIds": [
          "person-omri_2243-webp-1ki-16-17"
        ]
      },
      {
        "textJa": "イスラエルの民は二つに分かれ、一方はティブニを王にしようとしました。",
        "knownBy": {
          "chapter": 16,
          "verse": 21
        },
        "sourceIds": [
          "person-omri_2243-webp-1ki-16-21"
        ]
      },
      {
        "textJa": "アサ王第31年にオムリがイスラエルの王となり、12年間治めたと記されます。",
        "knownBy": {
          "chapter": 16,
          "verse": 23
        },
        "sourceIds": [
          "person-omri_2243-webp-1ki-16-23"
        ]
      },
      {
        "textJa": "オムリは死に、サマリアに葬られました。子アハブが後を継ぎました。",
        "knownBy": {
          "chapter": 16,
          "verse": 28
        },
