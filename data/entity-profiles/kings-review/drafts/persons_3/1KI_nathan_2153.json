    "facts": [
      {
        "textJa": "ナタンはバト・シェバに、アドニヤが王となったと伝え、ダビデの誓いを知らせるよう促しました。",
        "knownBy": {
          "chapter": 1,
          "verse": 11
        },
        "sourceIds": [
          "person-nathan_2153-webp-1ki-1-11"
        ]
      },
      {
        "textJa": "ダビデは祭司ザドク、預言者ナタン、ベナヤを呼びました。",
        "knownBy": {
          "chapter": 1,
          "verse": 32
        },
        "sourceIds": [
          "person-nathan_2153-webp-1ki-1-32"
        ]
      },
      {
        "textJa": "ナタンはザドクとともにソロモンに油を注ぐよう指示されました。",
        "knownBy": {
          "chapter": 1,
          "verse": 34
        },
        "sourceIds": [
          "person-nathan_2153-webp-1ki-1-34"
        ]
      },
      {
        "textJa": "ナタンの子アザリヤが役人たちを監督し、別の子ザブドが王の側近として記されます。",
        "knownBy": {
          "chapter": 4,
          "verse": 5
        },
        "sourceIds": [
          "person-nathan_2153-webp-1ki-4-5"
        ]
      }
    ],
