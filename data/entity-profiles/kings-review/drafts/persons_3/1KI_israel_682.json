    "facts": [
      {
        "textJa": "神殿建築は、イスラエルの子らがエジプトを出てから四百八十年目、ソロモンの治世第4年に始まりました。",
        "knownBy": {
          "chapter": 6,
          "verse": 1
        },
        "sourceIds": [
          "person-israel_682-webp-1ki-6-1"
        ]
      },
      {
        "textJa": "ソロモンはイスラエルの長たちを集め、契約の箱を運び上げました。",
        "knownBy": {
          "chapter": 8,
          "verse": 1
        },
        "sourceIds": [
          "person-israel_682-webp-1ki-8-1"
        ]
      },
      {
        "textJa": "ソロモンとイスラエルの人々は神殿を奉献しました。",
        "knownBy": {
          "chapter": 8,
          "verse": 63
        },
        "sourceIds": [
          "person-israel_682-webp-1ki-8-63"
        ]
      },
      {
        "textJa": "イスラエルの人々に禁じられていた諸国の女性との関係が、ソロモンの心を傾けました。",
        "knownBy": {
          "chapter": 11,
          "verse": 2
        },
        "sourceIds": [
          "person-israel_682-webp-1ki-11-2"
        ]
      }
    ],
