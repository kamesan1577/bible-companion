    "primaryWitnesses": [
      {
        "ref": "2KI 15:25",
        "textualBasisJa": "Pekah the son of Remaliah, his captain, conspired against him and attacked him in Samaria, in the fortress of the king’s house, with Argob and Arieh; and with him were fifty men of the Gileadites. He killed him, and reigned in his place."
      },
      {
        "ref": "2KI 15:27",
        "textualBasisJa": "In the fifty-second year of Azariah king of Judah, Pekah the son of Remaliah began to reign over Israel in Samaria for twenty years."
      },
      {
        "ref": "2KI 15:29",
        "textualBasisJa": "In the days of Pekah king of Israel, Tiglath Pileser king of Assyria came and took Ijon, Abel Beth Maacah, Janoah, Kedesh, Hazor, Gilead, and Galilee, all the land of Naphtali; and he carried them captive to Assyria."
      },
      {
        "ref": "2KI 15:30",
        "textualBasisJa": "Hoshea the son of Elah made a conspiracy against Pekah the son of Remaliah, attacked him, killed him, and reigned in his place, in the twentieth year of Jotham the son of Uzziah."
      },
      {
        "ref": "2KI 15:31",
        "textualBasisJa": "Now the rest of the acts of Pekah, and all that he did, behold, they are written in the book of the chronicles of the kings of Israel."
      },
      {
        "ref": "2KI 15:32",
        "textualBasisJa": "In the second year of Pekah the son of Remaliah king of Israel, Jotham the son of Uzziah king of Judah began to reign."
      },
      {
        "ref": "2KI 15:37",
        "textualBasisJa": "In those days, the LORD began to send Rezin the king of Syria and Pekah the son of Remaliah against Judah."
      },
      {
        "ref": "2KI 16:1",
        "textualBasisJa": "In the seventeenth year of Pekah the son of Remaliah, Ahaz the son of Jotham king of Judah began to reign."
      },
      {
        "ref": "2KI 16:5",
        "textualBasisJa": "Then Rezin king of Syria and Pekah son of Remaliah king of Israel came up to Jerusalem to wage war. They besieged Ahaz, but could not overcome him."
      }
    ],
