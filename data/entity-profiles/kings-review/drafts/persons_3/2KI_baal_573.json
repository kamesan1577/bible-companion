    "facts": [
      {
        "textJa": "エフーは人々に、アハブがバアルに少し仕えたなら自分は大いに仕えると偽って告げました。",
        "knownBy": {
          "chapter": 10,
          "verse": 18
        },
        "sourceIds": [
          "person-baal_573-webp-2ki-10-18"
        ]
      },
      {
        "textJa": "エフーはバアルのために大集会を開くよう命じました。",
        "knownBy": {
          "chapter": 10,
          "verse": 20
        },
        "sourceIds": [
          "person-baal_573-webp-2ki-10-20"
        ]
      },
      {
        "textJa": "エフーの従者たちはバアルの神殿に入り、参列者を打ちました。",
        "knownBy": {
          "chapter": 10,
          "verse": 25
        },
        "sourceIds": [
          "person-baal_573-webp-2ki-10-25"
        ]
      },
      {
        "textJa": "人々はバアルの神殿を壊し、祭壇と像を打ち砕きました。",
        "knownBy": {
          "chapter": 11,
          "verse": 18
        },
        "sourceIds": [
          "person-baal_573-webp-2ki-11-18"
        ]
      },
      {
        "textJa": "イスラエルの民は二つの子牛を作り、バアル像を造りました。",
        "knownBy": {
          "chapter": 17,
          "verse": 16
        },
        "sourceIds": [
          "person-baal_573-webp-2ki-17-16"
        ]
      }
    ],
