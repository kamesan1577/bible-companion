    "facts": [
      {
        "textJa": "エフーの仲間たちは衣を階段に敷き、彼を王として宣言しました。",
        "knownBy": {
          "chapter": 9,
          "verse": 13
        },
        "sourceIds": [
          "person-jehu_817-webp-2ki-9-13"
        ]
      },
      {
        "textJa": "エフーは弓でヨラムを射、矢は王の背を貫きました。",
        "knownBy": {
          "chapter": 9,
          "verse": 24
        },
        "sourceIds": [
          "person-jehu_817-webp-2ki-9-24"
        ]
      },
      {
        "textJa": "エフーはイズレエルへ行き、窓から外を見ていたイゼベルに向き合いました。",
        "knownBy": {
          "chapter": 9,
          "verse": 30
        },
        "sourceIds": [
          "person-jehu_817-webp-2ki-9-30"
        ]
      },
      {
        "textJa": "エフーはイズレエルに残るアハブ家の者や側近を打ちました。",
        "knownBy": {
          "chapter": 10,
          "verse": 11
        },
        "sourceIds": [
          "person-jehu_817-webp-2ki-10-11"
        ]
      },
      {
        "textJa": "主はエフーに、子孫が四代までイスラエルの王座に着くと告げました。",
        "knownBy": {
          "chapter": 10,
          "verse": 30
        },
        "sourceIds": [
          "person-jehu_817-webp-2ki-10-30"
        ]
      }
    ],
