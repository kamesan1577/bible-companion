    "primaryWitnesses": [
      {
        "ref": "2KI 14:21",
        "textualBasisJa": "All the people of Judah took Azariah, who was sixteen years old, and made him king in the place of his father Amaziah."
      },
      {
        "ref": "2KI 15:1",
        "textualBasisJa": "In the twenty-seventh year of Jeroboam king of Israel, Azariah son of Amaziah king of Judah began to reign."
      },
      {
        "ref": "2KI 15:6",
        "textualBasisJa": "Now the rest of the acts of Azariah, and all that he did, aren’t they written in the book of the chronicles of the kings of Judah?"
      },
      {
        "ref": "2KI 15:7",
        "textualBasisJa": "Azariah slept with his fathers; and they buried him with his fathers in David’s city; and Jotham his son reigned in his place."
      },
      {
        "ref": "2KI 15:8",
        "textualBasisJa": "In the thirty-eighth year of Azariah king of Judah, Zechariah the son of Jeroboam reigned over Israel in Samaria six months."
      },
      {
        "ref": "2KI 15:13",
        "textualBasisJa": "Shallum the son of Jabesh began to reign in the thirty-ninth year of Uzziah king of Judah, and he reigned for a month in Samaria."
      },
      {
        "ref": "2KI 15:17",
        "textualBasisJa": "In the thirty ninth year of Azariah king of Judah, Menahem the son of Gadi began to reign over Israel for ten years in Samaria."
      },
      {
        "ref": "2KI 15:23",
        "textualBasisJa": "In the fiftieth year of Azariah king of Judah, Pekahiah the son of Menahem began to reign over Israel in Samaria for two years."
      },
      {
        "ref": "2KI 15:27",
        "textualBasisJa": "In the fifty-second year of Azariah king of Judah, Pekah the son of Remaliah began to reign over Israel in Samaria for twenty years."
      },
      {
        "ref": "2KI 15:30",
        "textualBasisJa": "Hoshea the son of Elah made a conspiracy against Pekah the son of Remaliah, attacked him, killed him, and reigned in his place, in the twentieth year of Jotham the son of Uzziah."
      },
      {
        "ref": "2KI 15:32",
        "textualBasisJa": "In the second year of Pekah the son of Remaliah king of Israel, Jotham the son of Uzziah king of Judah began to reign."
      },
      {
        "ref": "2KI 15:34",
        "textualBasisJa": "He did that which was right in the LORD’s eyes. He did according to all that his father Uzziah had done."
      }
    ],
