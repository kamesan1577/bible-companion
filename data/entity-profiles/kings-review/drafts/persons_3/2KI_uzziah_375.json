    "facts": [
      {
        "textJa": "アザルヤはイスラエル王メナヘムの治世第39年に、シャルムの後を継ぐユダ王として呼ばれます。",
        "knownBy": {
          "chapter": 15,
          "verse": 13
        },
        "sourceIds": [
          "person-uzziah_375-webp-2ki-15-13"
        ]
      },
      {
        "textJa": "ホセアはペカに対して謀反を起こし、ユダ王ヨタムの治世第20年に王となりました。",
        "knownBy": {
          "chapter": 15,
          "verse": 30
        },
        "sourceIds": [
          "person-uzziah_375-webp-2ki-15-30"
        ]
      },
      {
        "textJa": "ヨタムはペカの治世第2年にユダの王となりました。",
        "knownBy": {
          "chapter": 15,
          "verse": 32
        },
        "sourceIds": [
          "person-uzziah_375-webp-2ki-15-32"
        ]
      },
      {
