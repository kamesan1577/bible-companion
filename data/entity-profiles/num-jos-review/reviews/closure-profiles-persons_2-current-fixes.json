        "facts": [
          {
            "textJa": "イスラエルの人々はヨシュアの命令どおり、ヨルダン川から十二の石を運び、宿営地に置いた。",
            "knownBy": {
              "chapter": 4,
              "verse": 8
            },
            "sourceIds": [
              "webp-jos-israel_682-4-8"
            ]
          },
          {
            "textJa": "イスラエルの人々はギルガルで過越祭を祝った。",
            "knownBy": {
              "chapter": 5,
              "verse": 10
            },
            "sourceIds": [
              "webp-jos-israel_682-5-10"
            ]
          },
          {
            "textJa": "アカンが奉納物を取ったため、主の怒りがイスラエルの人々に向いたと記される。",
            "knownBy": {
              "chapter": 7,
              "verse": 1
            },
            "sourceIds": [
              "webp-jos-israel_682-7-1"
            ]
          },
          {
            "textJa": "ギベオンの住民であるヒビ人を除き、イスラエルと和平を結ぶ町はなかったと述べられる。",
            "knownBy": {
              "chapter": 11,
              "verse": 19
            },
            "sourceIds": [
              "webp-jos-israel_682-11-19"
            ]
          },
          {
            "textJa": "イスラエルの全会衆はシロに集まり、そこで会見の天幕を設けた。",
            "knownBy": {
              "chapter": 18,
              "verse": 1
            },
            "sourceIds": [
              "webp-jos-israel_682-18-1"
            ]
          },
          {
            "textJa": "ルベン族、ガド族、マナセ半部族が祭壇を築いたと聞き、イスラエルの全会衆はシロに集まった。",
            "knownBy": {
              "chapter": 22,
              "verse": 12
            },
            "sourceIds": [
              "webp-jos-israel_682-22-12"
            ]
          },
          {
            "textJa": "イスラエルの人々がエジプトから携え上ったヨセフの骨は、シェケムに葬られた。",
            "knownBy": {
              "chapter": 24,
              "verse": 32
            },
            "sourceIds": [
              "webp-jos-israel_682-24-32"
            ]
          }
        ],
        "kind": "collective",
        "identityType": "collective"
      },
      "decision": "closed",
      "basisJa": "1:2 names Israel as the people to whom the land is given and commands crossing; the current base fields stay with this initial command. JOS24:4 is absent from collective passages and is represented by the separate existing-ID Jacob individual-context proposal; collective 24:32 remains a later collective reference.",
      "primaryWitnesses": [
        {
          "ref": "JOS 1:2",
          "url": "https://ebible.org/engwebp/JOS01.htm#V2",
          "text": "“Moses my servant is dead. Now therefore arise, go across this Jordan, you and all these people, to the land which I am giving to them, even to the children of Israel."
        },
        {
          "ref": "JOS 24:4",
          "url": "https://ebible.org/engwebp/JOS24.htm#V4",
          "text": "I gave to Isaac Jacob and Esau: and I gave to Esau Mount Seir, to possess it. Jacob and his children went down into Egypt."
        },
        {
          "ref": "JOS 24:32",
          "url": "https://ebible.org/engwebp/JOS24.htm#V32",
          "text": "They buried the bones of Joseph, which the children of Israel brought up out of Egypt, in Shechem, in the parcel of ground which Jacob bought from the sons of Hamor the father of Shechem for a hundred pieces of silver. They became the inheritance of the children of Joseph."
        }
      ]
    },
