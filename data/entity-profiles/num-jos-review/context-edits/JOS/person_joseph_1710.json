        "facts": [
          {
            "textJa": "ヨシュア記16:1はヨセフの子らの領地の境界を記し、16:4はマナセとエフライムが相続を受けたと述べます。",
            "knownBy": {
              "chapter": 16,
              "verse": 4
            },
            "sourceIds": [
              "JOS-joseph-web-jos-16-1",
              "JOS-joseph-web-jos-16-4"
            ]
          },
          {
            "textJa": "ヨシュア記17:14ではヨセフの子らが土地について申し立て、17:17ではヨシュアがエフライムとマナセに語りかけます。",
            "knownBy": {
              "chapter": 17,
              "verse": 17
            },
            "sourceIds": [
              "JOS-joseph-web-jos-17-14",
              "JOS-joseph-web-jos-17-17"
            ]
          },
          {
            "textJa": "ヨシュア記18:5はヨセフの子らに割り当てられた領域を述べ、18:11はヨセフの子らに属する領地の境界を記します。",
            "knownBy": {
              "chapter": 18,
              "verse": 11
            },
            "sourceIds": [
              "JOS-joseph-web-jos-18-5",
              "JOS-joseph-web-jos-18-11"
            ]
          },
          {
            "textJa": "ヨシュア記24:32は、埋葬されたヨセフ本人の骨とは別に、その土地がヨセフの子らの相続となったと記します。",
            "knownBy": {
              "chapter": 24,
              "verse": 32
            },
            "sourceIds": [
              "JOS-joseph-web-jos-24-32"
            ]
          }
        ],
