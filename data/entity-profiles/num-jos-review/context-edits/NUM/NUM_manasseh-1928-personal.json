    "primaryWitnesses": [
      {
        "ref": "NUM 26:28 (WEB)",
        "textualBasisJa": "The sons of Joseph after their families: Manasseh and Ephraim."
      },
      {
        "ref": "NUM 26:29 (WEB)",
        "textualBasisJa": "The sons of Manasseh: of Machir, the family of the Machirites; and Machir became the father of Gilead; of Gilead, the family of the Gileadites."
      },
      {
        "ref": "NUM 27:1 (WEB)",
        "textualBasisJa": "Then the daughters of Zelophehad, the son of Hepher, the son of Gilead, the son of Machir, the son of Manasseh, of the families of Manasseh the son of Joseph came near. These are the names of his daughters: Mahlah, Noah, Hoglah, Milcah, and Tirzah."
      },
      {
        "ref": "NUM 32:33 (WEB)",
        "textualBasisJa": "Moses gave to them, even to the children of Gad, and to the children of Reuben, and to the half-tribe of Manasseh the son of Joseph, the kingdom of Sihon king of the Amorites, and the kingdom of Og king of Bashan; the land, according to its cities and borders, even the cities of the surrounding land."
      },
      {
        "ref": "NUM 32:39 (WEB)",
        "textualBasisJa": "The children of Machir the son of Manasseh went to Gilead, took it, and dispossessed the Amorites who were therein."
      },
      {
        "ref": "NUM 32:40 (WEB)",
        "textualBasisJa": "Moses gave Gilead to Machir the son of Manasseh; and he lived therein."
      },
      {
        "ref": "NUM 32:41 (WEB)",
        "textualBasisJa": "Jair the son of Manasseh went and took its villages, and called them Havvoth Jair."
      },
      {
        "ref": "NUM 36:1 (WEB)",
        "textualBasisJa": "The heads of the fathers’ households of the family of the children of Gilead, the son of Machir, the son of Manasseh, of the families of the sons of Joseph, came near and spoke before Moses and before the princes, the heads of the fathers’ households of the children of Israel."
      }
    ],
