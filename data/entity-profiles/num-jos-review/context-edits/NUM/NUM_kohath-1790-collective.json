    "facts": [
      {
        "textJa": "コハト族の家系としてアムラム人、イツハル人、ヘブロン人、ウジエル人が挙げられる。",
        "knownBy": {
          "chapter": 3,
          "verse": 27
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-3-27"
        ]
      },
      {
        "textJa": "コハトの家族は幕屋の南側に宿営する。",
        "knownBy": {
          "chapter": 3,
          "verse": 29
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-3-29"
        ]
      },
      {
        "textJa": "コハト人の氏族の長としてウジエルの子エリザファンが挙げられる。",
        "knownBy": {
          "chapter": 3,
          "verse": 30
        },
        "sourceIds": [
          "webp-num-kohath_1790-3-30"
        ]
      },
      {
        "textJa": "コハトの子らには会見の天幕の最も聖なる物に関わる奉仕が定められる。",
        "knownBy": {
          "chapter": 4,
          "verse": 4
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-4-4"
        ]
      },
      {
        "textJa": "アロンと子らが聖所の品を覆った後、コハトの子らがそれを担う。",
        "knownBy": {
          "chapter": 4,
          "verse": 15
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-4-15"
        ]
      },
      {
        "textJa": "アロンと子らは、コハトの氏族が聖所に近づいても死なないように守る責任を担うと指示される。",
        "knownBy": {
          "chapter": 4,
          "verse": 19
        },
        "sourceIds": [
          "webp-num-NUM_kohath-1790-collective-4-19"
        ]
      },
      {
        "textJa": "コハトの家族から会見の天幕で働く者として数えられた人数が記される。",
        "knownBy": {
          "chapter": 4,
          "verse": 37
        },
        "sourceIds": [
          "webp-num-NUM_kohath-1790-collective-4-37"
        ]
      },
      {
        "textJa": "聖所の奉仕を担うため荷車は与えられず、肩で運ぶ。",
        "knownBy": {
          "chapter": 7,
          "verse": 9
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-7-9"
        ]
      },
      {
        "textJa": "コハト人は聖所を担い、他の者が到着前に幕屋を組み立てる。",
        "knownBy": {
          "chapter": 10,
          "verse": 21
        },
        "sourceIds": [
          "webp-num-NUM_kohath-1790-collective-10-21"
        ]
      },
      {
        "textJa": "レビ人の氏族人口調査にコハト人が記される。",
        "knownBy": {
          "chapter": 26,
          "verse": 57
        },
        "sourceIds": [
          "webp-num-kohath-1790-collective-26-57"
        ]
      }
    ],
