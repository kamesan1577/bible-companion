    "facts": [
      {
        "textJa": "ゲルションの家族はリブニ人、シムイ人として数えられる。",
        "knownBy": {
          "chapter": 3,
          "verse": 21
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-3-21"
        ]
      },
      {
        "textJa": "ゲルションの子らには会見の天幕の幕・覆いなどの管理が割り当てられる。",
        "knownBy": {
          "chapter": 3,
          "verse": 25
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-3-25"
        ]
      },
      {
        "textJa": "ゲルションの子らの奉仕はアロンの子イタマルの管理下に置かれる。",
        "knownBy": {
          "chapter": 4,
          "verse": 28
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-4-28"
        ]
      },
      {
        "textJa": "モーセはゲルションの子らに荷車二台と牛四頭を与える。",
        "knownBy": {
          "chapter": 7,
          "verse": 7
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-7-7"
        ]
      },
      {
        "textJa": "幕屋の撤収時、ゲルションの子らはメラリの子らとともに幕屋を運んで進む。",
        "knownBy": {
          "chapter": 10,
          "verse": 17
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-10-17"
        ]
      },
      {
        "textJa": "レビ人の氏族人口調査にゲルション人が記される。",
        "knownBy": {
          "chapter": 26,
          "verse": 57
        },
        "sourceIds": [
          "webp-num-gershon-1305-collective-26-57"
        ]
      }
    ],
