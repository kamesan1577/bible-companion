    "primaryWitnesses": [
      {
        "ref": "NUM 3:18 (WEB)",
        "textualBasisJa": "These are the names of the sons of Gershon by their families: Libni and Shimei."
      },
      {
        "ref": "NUM 3:21 (WEB)",
        "textualBasisJa": "Of Gershon was the family of the Libnites, and the family of the Shimeites. These are the families of the Gershonites."
      },
      {
        "ref": "NUM 3:22 (WEB)",
        "textualBasisJa": "Those who were counted of them, according to the number of all the males from a month old and upward, even those who were counted of them were seven thousand five hundred."
      },
      {
        "ref": "NUM 3:23 (WEB)",
        "textualBasisJa": "The families of the Gershonites shall encamp behind the tabernacle westward."
      },
      {
        "ref": "NUM 3:25 (WEB)",
        "textualBasisJa": "The duty of the sons of Gershon in the Tent of Meeting shall be the tabernacle, the tent, its covering, the screen for the door of the Tent of Meeting,"
      },
      {
        "ref": "NUM 3:26 (WEB)",
        "textualBasisJa": "the hangings of the court, the screen for the door of the court which is by the tabernacle and around the altar, and its cords for all of its service."
      },
      {
        "ref": "NUM 4:22 (WEB)",
        "textualBasisJa": "“Take a census of the sons of Gershon also, by their fathers’ houses, by their families;"
      },
      {
        "ref": "NUM 4:23 (WEB)",
        "textualBasisJa": "you shall count them from thirty years old and upward until fifty years old: all who enter in to wait on the service, to do the work in the Tent of Meeting."
      },
      {
        "ref": "NUM 4:24 (WEB)",
        "textualBasisJa": "“This is the service of the families of the Gershonites, in serving and in bearing burdens:"
      },
      {
        "ref": "NUM 4:25 (WEB)",
        "textualBasisJa": "they shall carry the curtains of the tabernacle and the Tent of Meeting, its covering, the covering of sealskin that is on it, the screen for the door of the Tent of Meeting,"
      },
      {
        "ref": "NUM 4:26 (WEB)",
        "textualBasisJa": "the hangings of the court, the screen for the door of the gate of the court which is by the tabernacle and around the altar, their cords, and all the instruments of their service, and whatever shall be done with them. They shall serve in there."
      },
      {
        "ref": "NUM 4:27 (WEB)",
        "textualBasisJa": "At the commandment of Aaron and his sons shall be all the service of the sons of the Gershonites, in all their burden and in all their service; and you shall appoint their duty to them in all their responsibilities."
      },
      {
        "ref": "NUM 4:28 (WEB)",
        "textualBasisJa": "This is the service of the families of the sons of the Gershonites in the Tent of Meeting. Their duty shall be under the hand of Ithamar the son of Aaron the priest."
      },
      {
        "ref": "NUM 4:38 (WEB)",
        "textualBasisJa": "Those who were counted of the sons of Gershon, by their families, and by their fathers’ houses,"
      },
      {
        "ref": "NUM 4:39 (WEB)",
        "textualBasisJa": "from thirty years old and upward even to fifty years old—everyone who entered into the service for work in the Tent of Meeting,"
      },
      {
        "ref": "NUM 4:40 (WEB)",
        "textualBasisJa": "even those who were counted of them, by their families, by their fathers’ houses, were two thousand six hundred thirty."
      },
      {
        "ref": "NUM 4:41 (WEB)",
        "textualBasisJa": "These are those who were counted of the families of the sons of Gershon, all who served in the Tent of Meeting, whom Moses and Aaron counted according to the commandment of the LORD."
      },
      {
        "ref": "NUM 7:7 (WEB)",
        "textualBasisJa": "He gave two wagons and four oxen to the sons of Gershon, according to their service."
      },
      {
        "ref": "NUM 10:17 (WEB)",
        "textualBasisJa": "The tabernacle was taken down; and the sons of Gershon and the sons of Merari, who bore the tabernacle, went forward."
      },
      {
        "ref": "NUM 26:57 (WEB)",
        "textualBasisJa": "These are those who were counted of the Levites after their families: of Gershon, the family of the Gershonites; of Kohath, the family of the Kohathites; of Merari, the family of the Merarites."
      }
    ],
