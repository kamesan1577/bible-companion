    "facts": [
      {
        "textJa": "メラリの家族はマフリ人とムシ人として示される。",
        "knownBy": {
          "chapter": 3,
          "verse": 33
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-3-33"
        ]
      },
      {
        "textJa": "メラリの氏族の宿営位置は幕屋の北側とされる。",
        "knownBy": {
          "chapter": 3,
          "verse": 35
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-3-35"
        ]
      },
      {
        "textJa": "幕屋の板、横木、柱、台座などがメラリの子らの担当に割り当てられる。",
        "knownBy": {
          "chapter": 3,
          "verse": 36
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-3-36"
        ]
      },
      {
        "textJa": "メラリの子らの奉仕内容が会見の天幕の管理として記される。",
        "knownBy": {
          "chapter": 4,
          "verse": 33
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-4-33"
        ]
      },
      {
        "textJa": "モーセはメラリの子らに荷車四台と牛八頭を与える。",
        "knownBy": {
          "chapter": 7,
          "verse": 8
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-7-8"
        ]
      },
      {
        "textJa": "幕屋の撤収時、メラリの子らはゲルションの子らとともに幕屋を運んで進む。",
        "knownBy": {
          "chapter": 10,
          "verse": 17
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-10-17"
        ]
      },
      {
        "textJa": "レビ人の氏族人口調査にメラリ人が記される。",
        "knownBy": {
          "chapter": 26,
          "verse": 57
        },
        "sourceIds": [
          "webp-num-merari-2004-collective-26-57"
        ]
      }
    ],
