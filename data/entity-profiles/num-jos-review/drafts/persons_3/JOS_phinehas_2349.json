    "facts": [
      {
        "textJa": "ピネハスと代表者たちは東岸の部族の説明を聞き、納得します。",
        "knownBy": {
          "chapter": 22,
          "verse": 30
        },
        "sourceIds": [
          "person-phinehas_2349-webp-jos-22-30"
        ]
      },
      {
        "textJa": "ピネハスは、主がイスラエルの中におられると分かった、と述べます。",
        "knownBy": {
          "chapter": 22,
          "verse": 31
        },
        "sourceIds": [
          "person-phinehas_2349-webp-jos-22-31"
        ]
      },
      {
        "textJa": "ピネハスらはカナンへ戻り、イスラエルの人々に報告します。",
        "knownBy": {
          "chapter": 22,
          "verse": 32
        },
        "sourceIds": [
          "person-phinehas_2349-webp-jos-22-32"
        ]
      },
      {
        "textJa": "エルアザルが死去し、エフライムの山地に葬られたことが記されます。",
