    "facts": [
      {
        "textJa": "ガド人はルベン人、マナセの半部族とともに、武装してイスラエルの人々の前を進んでヨルダン川を渡った。",
        "knownBy": {
          "chapter": 4,
          "verse": 12
        },
        "sourceIds": [
          "person-gad_1262-webp-jos-4-12"
        ]
      },
      {
        "textJa": "モーセはガド族に家族ごとの相続地を与えた。",
        "knownBy": {
          "chapter": 13,
          "verse": 24
        },
        "sourceIds": [
          "person-gad_1262-webp-jos-13-24"
        ]
      },
      {
        "textJa": "ガド族の相続地は、町とその村々から成ると記される。",
        "knownBy": {
          "chapter": 13,
          "verse": 28
        },
        "sourceIds": [
          "person-gad_1262-webp-jos-13-28"
        ]
      },
      {
        "textJa": "ガド族はルベン族、マナセ半部族とともにヨルダン川東側の相続地を受けたと記される。",
        "knownBy": {
          "chapter": 18,
          "verse": 7
        },
        "sourceIds": [
          "person-gad_1262-webp-jos-18-7"
        ]
      }
    ],
