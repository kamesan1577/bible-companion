    "facts": [
      {
        "textJa": "ヨシュアはカレブを祝福し、ヘブロンを相続地として与えます。",
        "knownBy": {
          "chapter": 14,
          "verse": 13
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-14-13"
        ]
      },
      {
        "textJa": "本文はヘブロンがカレブの相続地となった理由を、彼が主に忠実に従ったことと結び付けます。",
        "knownBy": {
          "chapter": 14,
          "verse": 14
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-14-14"
        ]
      },
      {
        "textJa": "ユダの相続地のうち、ヘブロン（旧名キルヤテ・アルバ）がカレブに割り当てられます。",
        "knownBy": {
          "chapter": 15,
          "verse": 13
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-15-13"
        ]
      },
      {
        "textJa": "カレブはアナクの三人の子を追い払います。",
        "knownBy": {
          "chapter": 15,
          "verse": 14
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-15-14"
        ]
      },
      {
        "textJa": "カレブはキルヤテ・セフェルを取る者に娘アクサを妻として与えると告げます。",
        "knownBy": {
          "chapter": 15,
          "verse": 16
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-15-16"
        ]
      },
      {
        "textJa": "オトニエルが町を攻略し、カレブは娘アクサを彼に与えます。",
        "knownBy": {
          "chapter": 15,
          "verse": 17
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-15-17"
        ]
      },
      {
        "textJa": "アクサが父カレブに畑を求めるよう夫に頼みます。",
        "knownBy": {
          "chapter": 15,
          "verse": 18
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-15-18"
        ]
      },
      {
        "textJa": "ヘブロンの町の畑と周囲の村は、カレブの所有として与えられます。",
        "knownBy": {
          "chapter": 21,
          "verse": 12
        },
        "sourceIds": [
          "person-caleb_537-webp-jos-21-12"
        ]
      }
    ],
