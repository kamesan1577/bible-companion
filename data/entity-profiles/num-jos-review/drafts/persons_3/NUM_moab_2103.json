    "facts": [
      {
        "textJa": "モアブはイスラエルの人々の数を恐れ、動揺したと記されています。",
        "knownBy": {
          "chapter": 22,
          "verse": 3
        },
        "sourceIds": [
          "person-moab_2103-webp-num-22-3"
        ]
      },
      {
        "textJa": "モアブはミディアンの長老たちに語りかけます。同じ節はバラクを当時のモアブ王と示します。",
        "knownBy": {
          "chapter": 22,
          "verse": 4
        },
        "sourceIds": [
          "person-moab_2103-webp-num-22-4"
        ]
      },
      {
        "textJa": "モアブの長老たちは占いの報酬を携え、ミディアンの長老たちとともにバラムのもとへ行きました。",
        "knownBy": {
          "chapter": 22,
          "verse": 7
        },
        "sourceIds": [
          "person-moab_2103-webp-num-22-7"
        ]
      },
      {
        "textJa": "イスラエルの人々はモアブの娘たちと関係を持ち始めたと記されています。",
        "knownBy": {
          "chapter": 25,
          "verse": 1
        },
        "sourceIds": [
          "person-moab_2103-webp-num-25-1"
        ]
      }
    ],
