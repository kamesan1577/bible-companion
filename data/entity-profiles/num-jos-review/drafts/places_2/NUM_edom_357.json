    "primaryWitnesses": [
      {
        "ref": "NUM 20:14",
        "textualBasisJa": "Moses sent messengers from Kadesh to the king of Edom, saying: “Your brother Israel says: You know all the travail that has happened to us;"
      },
      {
        "ref": "NUM 20:18",
        "textualBasisJa": "Edom said to him, “You shall not pass through me, lest I come out with the sword against you.”"
      },
      {
        "ref": "NUM 20:20",
        "textualBasisJa": "He said, “You shall not pass through.” Edom came out against him with many people, and with a strong hand."
      },
      {
        "ref": "NUM 20:21",
        "textualBasisJa": "Thus Edom refused to give Israel passage through his border, so Israel turned away from him."
      },
      {
        "ref": "NUM 20:23",
        "textualBasisJa": "The LORD spoke to Moses and Aaron in Mount Hor, by the border of the land of Edom, saying,"
      },
      {
        "ref": "NUM 21:4",
        "textualBasisJa": "They traveled from Mount Hor by the way to the Red Sea, to go around the land of Edom. The soul of the people was very discouraged because of the journey."
      },
      {
        "ref": "NUM 24:18",
        "textualBasisJa": "Edom shall be a possession. Seir, his enemy, also shall be a possession, while Israel does valiantly."
      },
      {
        "ref": "NUM 33:37",
        "textualBasisJa": "They traveled from Kadesh, and encamped in Mount Hor, in the edge of the land of Edom."
      },
      {
        "ref": "NUM 34:3",
        "textualBasisJa": "then your south quarter shall be from the wilderness of Zin along by the side of Edom, and your south border shall be from the end of the Salt Sea eastward."
      }
    ],
