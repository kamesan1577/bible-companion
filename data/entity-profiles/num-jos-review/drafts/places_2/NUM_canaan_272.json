    "primaryWitnesses": [
      {
        "ref": "NUM 13:2",
        "textualBasisJa": "“Send men, that they may spy out the land of Canaan, which I give to the children of Israel. Of every tribe of their fathers, you shall send a man, every one a prince among them.”"
      },
      {
        "ref": "NUM 13:17",
        "textualBasisJa": "Moses sent them to spy out the land of Canaan, and said to them, “Go up this way by the South, and go up into the hill country."
      },
      {
        "ref": "NUM 26:19",
        "textualBasisJa": "The sons of Judah: Er and Onan. Er and Onan died in the land of Canaan."
      },
      {
        "ref": "NUM 32:30",
        "textualBasisJa": "but if they will not pass over with you armed, they shall have possessions among you in the land of Canaan.”"
      },
      {
        "ref": "NUM 32:32",
        "textualBasisJa": "We will pass over armed before the LORD into the land of Canaan, and the possession of our inheritance shall remain with us beyond the Jordan.”"
      },
      {
        "ref": "NUM 33:40",
        "textualBasisJa": "The Canaanite king of Arad, who lived in the South in the land of Canaan, heard of the coming of the children of Israel."
      },
      {
        "ref": "NUM 33:51",
        "textualBasisJa": "Speak to the children of Israel, and tell them, “When you pass over the Jordan into the land of Canaan,"
      },
      {
        "ref": "NUM 34:2",
        "textualBasisJa": "“Command the children of Israel, and tell them, ‘When you come into the land of Canaan (this is the land that shall fall to you for an inheritance, even the land of Canaan according to its borders),"
      },
      {
        "ref": "NUM 34:29",
        "textualBasisJa": "These are they whom the LORD commanded to divide the inheritance to the children of Israel in the land of Canaan."
      },
      {
        "ref": "NUM 35:10",
        "textualBasisJa": "“Speak to the children of Israel, and tell them, ‘When you pass over the Jordan into the land of Canaan,"
      },
      {
        "ref": "NUM 35:14",
        "textualBasisJa": "You shall give three cities beyond the Jordan, and you shall give three cities in the land of Canaan. They shall be cities of refuge."
      }
    ],
