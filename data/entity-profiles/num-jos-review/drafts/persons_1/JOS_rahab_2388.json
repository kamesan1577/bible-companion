    "facts": [
      {
        "textJa": "エリコの王がラハブに使者を引き渡すよう求める。",
        "knownBy": {
          "chapter": 2,
          "verse": 3
        },
        "sourceIds": [
          "webp-jos-2-3"
        ]
      },
      {
        "textJa": "ラハブは斥候たちを屋上に隠したと語る。",
        "knownBy": {
          "chapter": 2,
          "verse": 6
        },
        "sourceIds": [
          "webp-jos-2-6"
        ]
      },
      {
        "textJa": "町が聖絶される中、ラハブと家にいる者は助けられるよう命じられる。",
        "knownBy": {
          "chapter": 6,
          "verse": 17
        },
        "sourceIds": [
          "webp-jos-6-17"
        ]
      },
      {
        "textJa": "斥候たちはラハブと家族を町から連れ出す。",
        "knownBy": {
          "chapter": 6,
          "verse": 23
        },
        "sourceIds": [
          "webp-jos-6-23"
        ]
      },
      {
        "textJa": "ヨシュアはラハブと父の家を生かし、本文は彼女がイスラエルの中に住むと記す。",
        "knownBy": {
          "chapter": 6,
          "verse": 25
        },
