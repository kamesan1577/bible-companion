    "primaryWitnesses": [
      {
        "ref": "NUM 3:17",
        "textualBasisJa": "These were the sons of Levi by their names: Gershon, Kohath, and Merari."
      },
      {
        "ref": "NUM 3:19",
        "textualBasisJa": "The sons of Kohath by their families: Amram, Izhar, Hebron, and Uzziel."
      },
      {
        "ref": "NUM 3:27",
        "textualBasisJa": "Of Kohath was the family of the Amramites, the family of the Izharites, the family of the Hebronites, and the family of the Uzzielites. These are the families of the Kohathites."
      },
      {
        "ref": "NUM 3:29",
        "textualBasisJa": "The families of the sons of Kohath shall encamp on the south side of the tabernacle."
      },
      {
        "ref": "NUM 4:2",
        "textualBasisJa": "“Take a census of the sons of Kohath from among the sons of Levi, by their families, by their fathers’ houses,"
      },
      {
        "ref": "NUM 4:4",
        "textualBasisJa": "“This is the service of the sons of Kohath in the Tent of Meeting, regarding the most holy things."
      },
      {
        "ref": "NUM 4:15",
        "textualBasisJa": "“When Aaron and his sons have finished covering the sanctuary and all the furniture of the sanctuary, as the camp moves forward; after that, the sons of Kohath shall come to carry it; but they shall not touch the sanctuary, lest they die. The sons of Kohath shall carry these things belonging to the Tent of Meeting."
      },
      {
        "ref": "NUM 7:9",
        "textualBasisJa": "But to the sons of Kohath he gave none, because the service of the sanctuary belonged to them; they carried it on their shoulders."
      },
      {
        "ref": "NUM 16:1",
        "textualBasisJa": "Now Korah, the son of Izhar, the son of Kohath, the son of Levi, with Dathan and Abiram, the sons of Eliab, and On, the son of Peleth, sons of Reuben, took some men."
      },
      {
        "ref": "NUM 26:57",
        "textualBasisJa": "These are those who were counted of the Levites after their families: of Gershon, the family of the Gershonites; of Kohath, the family of the Kohathites; of Merari, the family of the Merarites."
      },
      {
        "ref": "NUM 26:58",
        "textualBasisJa": "These are the families of Levi: the family of the Libnites, the family of the Hebronites, the family of the Mahlites, the family of the Mushites, and the family of the Korahites. Kohath became the father of Amram."
      }
    ],
