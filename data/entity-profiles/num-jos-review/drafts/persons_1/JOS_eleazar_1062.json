    "facts": [
      {
        "textJa": "ツェロフハデの娘たちが兄弟たちの間の相続地を求め、エルアザルらに申し立てた。",
        "knownBy": {
          "chapter": 17,
          "verse": 4
        },
        "sourceIds": [
          "webp-jos-17-4"
        ]
      },
      {
        "textJa": "エルアザル、ヨシュア、部族の父祖の家の長たちがシロでくじによって土地を分配した。",
        "knownBy": {
          "chapter": 19,
          "verse": 51
        },
        "sourceIds": [
          "webp-jos-19-51"
        ]
      },
      {
        "textJa": "レビ人の父祖の家の長たちがエルアザルとヨシュアらのもとへ来た。",
        "knownBy": {
          "chapter": 21,
          "verse": 1
        },
        "sourceIds": [
          "webp-jos-21-1"
        ]
      },
      {
        "textJa": "エルアザルの子フィネハスが、ルベン、ガド、マナセの半部族へ使節として派遣された。",
        "knownBy": {
          "chapter": 22,
          "verse": 13
        },
        "sourceIds": [
          "webp-jos-22-13"
        ]
      },
      {
        "textJa": "フィネハスは相手部族の説明を聞き、主への背信ではないと判断した。",
        "knownBy": {
          "chapter": 22,
          "verse": 31
        },
        "sourceIds": [
          "webp-jos-22-31"
        ]
      },
      {
        "textJa": "フィネハスと諸侯はギレアデからカナンへ戻り、報告した。",
        "knownBy": {
          "chapter": 22,
          "verse": 32
        },
        "sourceIds": [
          "webp-jos-22-32"
        ]
      },
      {
        "textJa": "エルアザルは死去し、息子フィネハスに与えられた丘に葬られた。",
        "knownBy": {
          "chapter": 24,
          "verse": 33
        },
        "sourceIds": [
          "webp-jos-24-33"
        ]
      }
    ],
