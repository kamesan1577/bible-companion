    "facts": [
      {
        "textJa": "ユダ族の相続地は家族ごとにくじで定められ、南側はエドムの境界から始まる。",
        "knownBy": {
          "chapter": 15,
          "verse": 1
        },
        "sourceIds": [
          "webp-jos-15-1"
        ]
      },
      {
        "textJa": "西の境界は大海の岸までと記される。",
        "knownBy": {
          "chapter": 15,
          "verse": 12
        },
        "sourceIds": [
          "webp-jos-15-12"
        ]
      },
      {
        "textJa": "エルサレムに住むエブス人は、ユダの子らによって追い出されず、彼らとともに住み続けた。",
        "knownBy": {
          "chapter": 15,
          "verse": 63
        },
        "sourceIds": [
          "webp-jos-15-63"
        ]
      },
      {
        "textJa": "ユダの相続分からシメオン族の相続地が割り当てられた。",
        "knownBy": {
          "chapter": 19,
          "verse": 9
        },
        "sourceIds": [
          "webp-jos-19-9"
        ]
      },
      {
        "textJa": "ユダの山地にある避難の町としてヘブロンが挙げられる。",
        "knownBy": {
          "chapter": 20,
          "verse": 7
        },
        "sourceIds": [
          "webp-jos-20-7"
        ]
      },
      {
        "textJa": "アロンの子孫であるコハテ族の町がユダ族・シメオン族・ベニヤミン族の地から割り当てられた。",
        "knownBy": {
          "chapter": 21,
          "verse": 4
        },
        "sourceIds": [
          "webp-jos-21-4"
        ]
      }
    ],
    "modernLocationJa": null,
    "historicalRoleJa": "部族。相続地・境界・町の配分で言及される。",
