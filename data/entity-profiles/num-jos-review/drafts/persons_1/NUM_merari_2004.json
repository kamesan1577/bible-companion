    "primaryWitnesses": [
      {
        "ref": "NUM 3:17",
        "textualBasisJa": "These were the sons of Levi by their names: Gershon, Kohath, and Merari."
      },
      {
        "ref": "NUM 3:20",
        "textualBasisJa": "The sons of Merari by their families: Mahli and Mushi. These are the families of the Levites according to their fathers’ houses."
      },
      {
        "ref": "NUM 3:33",
        "textualBasisJa": "Of Merari was the family of the Mahlites and the family of the Mushites. These are the families of Merari."
      },
      {
        "ref": "NUM 3:35",
        "textualBasisJa": "The prince of the fathers’ house of the families of Merari was Zuriel the son of Abihail. They shall encamp on the north side of the tabernacle."
      },
      {
        "ref": "NUM 3:36",
        "textualBasisJa": "The appointed duty of the sons of Merari shall be the tabernacle’s boards, its bars, its pillars, its sockets, all its instruments, all its service,"
      },
      {
        "ref": "NUM 4:29",
        "textualBasisJa": "“As for the sons of Merari, you shall count them by their families, by their fathers’ houses;"
      },
      {
        "ref": "NUM 4:33",
        "textualBasisJa": "This is the service of the families of the sons of Merari, according to all their service in the Tent of Meeting, under the hand of Ithamar the son of Aaron the priest.”"
      },
      {
        "ref": "NUM 4:42",
        "textualBasisJa": "Those who were counted of the families of the sons of Merari, by their families, by their fathers’ houses,"
      },
      {
        "ref": "NUM 4:45",
        "textualBasisJa": "These are those who were counted of the families of the sons of Merari, whom Moses and Aaron counted according to the commandment of the LORD by Moses."
      },
      {
        "ref": "NUM 7:8",
        "textualBasisJa": "He gave four wagons and eight oxen to the sons of Merari, according to their service, under the direction of Ithamar the son of Aaron the priest."
      },
      {
        "ref": "NUM 10:17",
        "textualBasisJa": "The tabernacle was taken down; and the sons of Gershon and the sons of Merari, who bore the tabernacle, went forward."
      },
      {
        "ref": "NUM 26:57",
        "textualBasisJa": "These are those who were counted of the Levites after their families: of Gershon, the family of the Gershonites; of Kohath, the family of the Kohathites; of Merari, the family of the Merarites."
      }
    ],
