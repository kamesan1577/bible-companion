    "facts": [
      {
        "textJa": "アロンの祭服がエルアザルに着せられ、アロンがホル山で死んだと記される。",
        "knownBy": {
          "chapter": 20,
          "verse": 28
        },
        "sourceIds": [
          "webp-num-eleazar-20-28"
        ]
      },
      {
        "textJa": "ヨシュアはエルアザルの前に立ち、ウリムによる判断を求めると命じられる。",
        "knownBy": {
          "chapter": 27,
          "verse": 21
        },
        "sourceIds": [
          "webp-num-eleazar-27-21"
        ]
      },
      {
        "textJa": "エルアザルとヨシュアが相続地を分ける担当者に挙げられる。",
        "knownBy": {
          "chapter": 34,
          "verse": 17
        },
        "sourceIds": [
          "webp-num-eleazar-34-17"
        ]
      }
    ],
