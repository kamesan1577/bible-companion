    "primaryWitnesses": [
      {
        "ref": "NUM 3:2 (WEB)",
        "textualBasisJa": "These are the names of the sons of Aaron: Nadab the firstborn, and Abihu, Eleazar, and Ithamar."
      },
      {
        "ref": "NUM 3:4 (WEB)",
        "textualBasisJa": "Nadab and Abihu died before the LORD when they offered strange fire before the LORD in the wilderness of Sinai, and they had no children. Eleazar and Ithamar ministered in the priest’s office in the presence of Aaron their father."
      },
      {
        "ref": "NUM 4:28 (WEB)",
        "textualBasisJa": "This is the service of the families of the sons of the Gershonites in the Tent of Meeting. Their duty shall be under the hand of Ithamar the son of Aaron the priest."
      },
      {
        "ref": "NUM 4:33 (WEB)",
        "textualBasisJa": "This is the service of the families of the sons of Merari, according to all their service in the Tent of Meeting, under the hand of Ithamar the son of Aaron the priest.”"
      },
      {
        "ref": "NUM 7:8 (WEB)",
        "textualBasisJa": "He gave four wagons and eight oxen to the sons of Merari, according to their service, under the direction of Ithamar the son of Aaron the priest."
      },
      {
        "ref": "NUM 26:60 (WEB)",
        "textualBasisJa": "To Aaron were born Nadab and Abihu, Eleazar and Ithamar."
      }
    ],
