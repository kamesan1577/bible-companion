    "facts": [
      {
        "textJa": "斥候カレブは民を静め、上って土地を得ようと主張した。",
        "knownBy": {
          "chapter": 13,
          "verse": 30
        },
        "sourceIds": [
          "webp-num-caleb-13-30"
        ]
      },
      {
        "textJa": "主はカレブが従い通したことを理由に、彼をその地へ導くと述べる。",
        "knownBy": {
          "chapter": 14,
          "verse": 24
        },
        "sourceIds": [
          "webp-num-caleb-14-24"
        ]
      },
      {
        "textJa": "斥候のうちヨシュアとカレブは生き残ったと記される。",
        "knownBy": {
          "chapter": 14,
          "verse": 38
        },
        "sourceIds": [
          "webp-num-caleb-14-38"
        ]
      },
      {
        "textJa": "カレブは主に従い通した者として回顧される。",
        "knownBy": {
          "chapter": 32,
          "verse": 12
        },
        "sourceIds": [
          "webp-num-caleb-32-12"
        ]
      },
      {
        "textJa": "カレブはユダ族の土地分配担当者の一人に挙げられる。",
        "knownBy": {
          "chapter": 34,
          "verse": 19
        },
        "sourceIds": [
          "webp-num-caleb-34-19"
        ]
      }
