    "facts": [
      {
        "textJa": "ヨシュア記5:1は、ヨルダン川の西側にいたアモリ人の王たちが川の水が止まったと聞き、イスラエルを恐れたと記す。",
        "knownBy": {
          "chapter": 5,
          "verse": 1
        },
        "sourceIds": [
          "webp-jos-amorite_237-5-1"
        ]
      },
      {
        "textJa": "ヨシュア記10:5は、エルサレム、ヘブロン、ヤルムテ、ラキシュ、エグロンのアモリ人の五王が集まり、ギベオンに攻め上ったと記す。",
        "knownBy": {
          "chapter": 10,
          "verse": 5
        },
        "sourceIds": [
          "webp-jos-amorite_237-10-5"
        ]
      },
      {
        "textJa": "ヨシュア記10:12は、主がアモリ人をイスラエルに渡された日にヨシュアが語った、と述べる。",
        "knownBy": {
          "chapter": 10,
          "verse": 12
        },
        "sourceIds": [
          "webp-jos-amorite_237-10-12"
        ]
      },
      {
        "textJa": "ヨシュア記24:8は、ヨルダン川の向こうに住むアモリ人との戦いと、その土地を得たという回顧を記す。",
        "knownBy": {
          "chapter": 24,
          "verse": 8
        },
        "sourceIds": [
          "webp-jos-amorite_237-24-8"
        ]
      },
      {
        "textJa": "ヨシュア記24:15は、先祖が川の向こうで仕えた神々と、イスラエルが住む土地のアモリ人の神々を対照に挙げる。",
        "knownBy": {
          "chapter": 24,
          "verse": 15
        },
        "sourceIds": [
          "webp-jos-amorite_237-24-15"
        ]
      }
    ],
