    "facts": [
      {
        "textJa": "部族・家ごとの選別でアカンが選び出された。",
        "knownBy": {
          "chapter": 7,
          "verse": 18
        },
        "sourceIds": [
          "webp-jos-achan_61-7-18"
        ]
      },
      {
        "textJa": "ヨシュアはアカンに告白し、行ったことを隠さず話すよう求めた。",
        "knownBy": {
          "chapter": 7,
          "verse": 19
        },
        "sourceIds": [
          "webp-jos-achan_61-7-19"
        ]
      },
      {
        "textJa": "アカンは主に対して罪を犯したと認めた。",
        "knownBy": {
          "chapter": 7,
          "verse": 20
        },
        "sourceIds": [
          "webp-jos-achan_61-7-20"
        ]
      },
      {
        "textJa": "アカンはバビロン風の衣、銀、金を見て欲し、それらを自分の天幕の地中に隠したと述べた。",
        "knownBy": {
          "chapter": 7,
          "verse": 21
        },
        "sourceIds": [
          "webp-jos-achan_61-7-21"
        ]
      },
      {
        "textJa": "ヨシュアとイスラエルの人々はアカンとその所有物をアコルの谷へ連れて行った。",
        "knownBy": {
          "chapter": 7,
          "verse": 24
        },
        "sourceIds": [
          "webp-jos-achan_61-7-24"
        ]
      },
      {
        "textJa": "イスラエルの人々がアカンを石で打ち、アカンの上に大きな石塚を築いたと記される。",
        "knownBy": {
          "chapter": 7,
          "verse": 26
        },
        "sourceIds": [
          "webp-jos-achan_61-7-26"
        ]
      },
      {
        "textJa": "後の回顧では、アカンが禁じられた物について罪を犯し、その罪のため一人だけで死んだのではないと述べられる。",
        "knownBy": {
          "chapter": 22,
          "verse": 20
        },
        "sourceIds": [
          "webp-jos-achan_61-22-20"
        ]
      }
    ],
