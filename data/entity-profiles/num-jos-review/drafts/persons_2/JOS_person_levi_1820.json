    "facts": [
      {
        "textJa": "ヨシュア記8:33は、契約の箱の前に立つレビ人の祭司たちを記します。",
        "knownBy": {
          "chapter": 8,
          "verse": 33
        },
        "sourceIds": [
          "webp-jos-levi_1820-8-33"
        ]
      },
      {
        "textJa": "土地の相続について、レビ族には土地の嗣業が与えられず、主への火による供え物が嗣業とされたと記されます。",
        "knownBy": {
          "chapter": 13,
          "verse": 14
        },
        "sourceIds": [
          "webp-jos-levi_1820-13-14"
        ]
      },
      {
        "textJa": "後の説明では、レビ族に土地の相続は与えられず、主がその嗣業とされたと述べられます。",
        "knownBy": {
          "chapter": 13,
          "verse": 33
        },
        "sourceIds": [
          "webp-jos-levi_1820-13-33"
        ]
      },
      {
        "textJa": "土地の相続を受けない一方、レビ人には居住する町と放牧地が与えられたと説明されます。",
        "knownBy": {
          "chapter": 14,
          "verse": 4
        },
        "sourceIds": [
          "webp-jos-levi_1820-14-3",
          "webp-jos-levi_1820-14-4"
        ]
      },
      {
        "textJa": "レビ人は主の祭司職を嗣業とすると述べられます。",
        "knownBy": {
          "chapter": 18,
          "verse": 7
        },
        "sourceIds": [
          "webp-jos-levi_1820-18-7"
        ]
      },
      {
        "textJa": "レビ人の父祖の家の長たちはエルアザル、ヨシュア、各部族の長たちのもとに来て、命令された町々を求めます。",
        "knownBy": {
          "chapter": 21,
          "verse": 3
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-1",
          "webp-jos-levi_1820-21-3"
        ]
      },
      {
        "textJa": "コハテ族のうちアロンの子孫はユダ、シメオン、ベニヤミンの領域から十三の町を得たと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 10
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-4",
          "webp-jos-levi_1820-21-10"
        ]
      },
      {
        "textJa": "コハテ族の残りの家族にも町が割り当てられたと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 20
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-20"
        ]
      },
      {
        "textJa": "ゲルショム族にも町が割り当てられたと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 27
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-27"
        ]
      },
      {
        "textJa": "メラリ族にも各部族の領域から町が割り当てられたと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 34
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-34"
        ]
      },
      {
        "textJa": "メラリ族の町も含め、レビ人に与えられた町はイスラエルの領地の中に四十八あったと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 41
        },
        "sourceIds": [
          "webp-jos-levi_1820-21-40",
          "webp-jos-levi_1820-21-41"
        ]
      }
    ],
