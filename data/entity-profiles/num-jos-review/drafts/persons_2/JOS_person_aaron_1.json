    "facts": [
      {
        "textJa": "祭司アロンの子孫はコハテ族に属し、ユダ、シメオン、ベニヤミンの各部族領から町を受けたと記される。",
        "knownBy": {
          "chapter": 21,
          "verse": 13
        },
        "sourceIds": [
          "webp-jos-aaron_1-21-13"
        ]
      },
      {
        "textJa": "ヨシュアの回顧では、神がモーセとアロンを遣わし、エジプトに災いを行った後に民を導き出したと語られる。",
        "knownBy": {
          "chapter": 24,
          "verse": 5
        },
        "sourceIds": [
          "webp-jos-aaron_1-24-5"
        ]
      },
      {
        "textJa": "エレアザルはアロンの子と記され、ヨシュア記の結びでその死と埋葬が述べられる。",
        "knownBy": {
          "chapter": 24,
          "verse": 33
        },
