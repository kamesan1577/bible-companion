    "facts": [
      {
        "textJa": "アルノン川がモアブとアモリ人の境界に当たると記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 13
        },
        "sourceIds": [
          "webp-num-amorite_237-21-13"
        ]
      },
      {
        "textJa": "シホンはアモリ人の王として名指され、イスラエルの使者が彼に和平を求めます。",
        "knownBy": {
          "chapter": 21,
          "verse": 21
        },
        "sourceIds": [
          "webp-num-amorite_237-21-21"
        ]
      },
      {
        "textJa": "イスラエルはヘシュボンなどアモリ人の町々に住み、シホンがかつてモアブからアルノンまでの土地を支配したと回顧されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 26
        },
        "sourceIds": [
          "webp-num-amorite_237-21-25",
          "webp-num-amorite_237-21-26"
        ]
      },
      {
        "textJa": "モアブへの詩歌は、シホンをアモリ人の王と呼びます。",
        "knownBy": {
          "chapter": 21,
          "verse": 29
        },
        "sourceIds": [
          "webp-num-amorite_237-21-29"
        ]
      },
      {
        "textJa": "イスラエルはアモリ人の土地に住み、ヤゼル周辺でアモリ人を追い払ったと記されます。",
        "knownBy": {
          "chapter": 21,
          "verse": 32
        },
        "sourceIds": [
          "webp-num-amorite_237-21-31",
          "webp-num-amorite_237-21-32"
        ]
      },
      {
        "textJa": "主はシホン王とその民・土地についてモーセに語り、イスラエルが勝利することを告げます。",
        "knownBy": {
          "chapter": 21,
          "verse": 34
        },
        "sourceIds": [
          "webp-num-amorite_237-21-34"
        ]
      },
      {
        "textJa": "バラクは、イスラエルがアモリ人にしたことを見て恐れます。",
        "knownBy": {
          "chapter": 22,
          "verse": 2
        },
        "sourceIds": [
          "webp-num-amorite_237-22-2"
        ]
      },
      {
        "textJa": "モーセは、ガド族・ルベン族・マナセの半部族にシホン王国を与えたと記されます。",
        "knownBy": {
          "chapter": 32,
          "verse": 33
        },
        "sourceIds": [
          "webp-num-amorite_237-32-33"
        ]
      },
      {
        "textJa": "マナセの子マキルの子らがギレアドへ進み、そこにいたアモリ人を追い払ったと記されます。",
        "knownBy": {
          "chapter": 32,
          "verse": 39
        },
        "sourceIds": [
          "webp-num-amorite_237-32-39"
        ]
      }
    ],
