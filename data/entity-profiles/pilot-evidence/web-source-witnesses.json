    "sourceBook": "ACT",
    "sourceChapter": 13,
    "sourceVerse": "9",
    "text": "But Saul, who is also called Paul, filled with the Holy Spirit, fastened his eyes on him",
    "canonical": {
      "book": "ACT",
      "chapter": 13,
      "verse": 9
    },
    "alignment": "canonical-compatible",
    "textStatus": "present",
    "verification": "literal-source",
    "editorialReview": "unreviewed"
  },
  {
    "sourceId": "webp",
    "version": "webp-usfx-2026-10-13-35a6adf626e5",
    "sourceBook": "ACT",
    "sourceChapter": 13,
    "sourceVerse": "16",
    "text": "Paul stood up, and gesturing with his hand said, “Men of Israel, and you who fear God, listen.",
    "canonical": {
      "book": "ACT",
      "chapter": 13,
      "verse": 16
    },
    "alignment": "canonical-compatible",
    "textStatus": "present",
    "verification": "literal-source",
    "editorialReview": "unreviewed"
  },
  {
    "sourceId": "webp",
    "version": "webp-usfx-2026-10-13-35a6adf626e5",
    "sourceBook": "ACT",
    "sourceChapter": 13,
    "sourceVerse": "24",
    "text": "before his coming, when John had first preached the baptism of repentance to Israel.",
    "canonical": {
      "book": "ACT",
      "chapter": 13,
      "verse": 24
    },
    "alignment": "canonical-compatible",
    "textStatus": "present",
    "verification": "literal-source",
    "editorialReview": "unreviewed"
  },
  {
