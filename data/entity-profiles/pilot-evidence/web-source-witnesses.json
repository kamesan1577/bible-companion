    "sourceBook": "ACT",
    "sourceChapter": 4,
    "sourceVerse": "10",
    "text": "may it be known to you all, and to all the people of Israel, that in the name of Jesus Christ of Nazareth, whom you crucified, whom God raised from the dead, this man stands here before you whole in him.",
    "canonical": {
      "book": "ACT",
      "chapter": 4,
      "verse": 10
