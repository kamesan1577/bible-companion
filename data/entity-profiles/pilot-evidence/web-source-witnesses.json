    "sourceBook": "ACT",
    "sourceChapter": 19,
    "sourceVerse": "1",
    "text": "While Apollos was at Corinth, Paul, having passed through the upper country, came to Ephesus and found certain disciples.",
    "canonical": {
      "book": "ACT",
      "chapter": 19,
      "verse": 1
    },
    "alignment": "canonical-compatible",
    "textStatus": "present",
    "verification": "literal-source",
    "editorialReview": "unreviewed"
  },
  {
