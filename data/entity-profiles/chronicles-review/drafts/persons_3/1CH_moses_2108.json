    "primaryWitnesses": [
      {
        "ref": "1CH 6:3",
        "textualBasisJa": "The children of Amram: Aaron, Moses, and Miriam. The sons of Aaron: Nadab, Abihu, Eleazar, and Ithamar."
      },
      {
        "ref": "1CH 6:49",
        "textualBasisJa": "But Aaron and his sons offered on the altar of burnt offering, and on the altar of incense, for all the work of the most holy place, and to make atonement for Israel, according to all that Moses the servant of God had commanded."
      },
      {
        "ref": "1CH 15:15",
        "textualBasisJa": "The children of the Levites bore God’s ark on their shoulders with its poles, as Moses commanded according to the LORD’s word."
      },
      {
        "ref": "1CH 21:29",
        "textualBasisJa": "For the LORD’s tabernacle, which Moses made in the wilderness, and the altar of burnt offering, were at that time in the high place at Gibeon."
      },
      {
        "ref": "1CH 22:13",
        "textualBasisJa": "Then you will prosper, if you observe to do the statutes and the ordinances which the LORD gave Moses concerning Israel. Be strong and courageous. Don’t be afraid and don’t be dismayed."
      },
      {
        "ref": "1CH 23:13",
        "textualBasisJa": "The sons of Amram: Aaron and Moses; and Aaron was separated that he should sanctify the most holy things, he and his sons forever, to burn incense before the LORD, to minister to him, and to bless in his name forever."
      },
      {
        "ref": "1CH 23:14",
        "textualBasisJa": "But as for Moses the man of God, his sons were named among the tribe of Levi."
      },
      {
        "ref": "1CH 23:15",
        "textualBasisJa": "The sons of Moses: Gershom and Eliezer."
      },
      {
        "ref": "1CH 26:24",
        "textualBasisJa": "Shebuel the son of Gershom, the son of Moses, was ruler over the treasuries."
      }
    ],
