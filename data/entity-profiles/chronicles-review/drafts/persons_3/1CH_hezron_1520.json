    "facts": [
      {
        "textJa": "ヘツロンの子らとしてエラフメエル、ラム、ケルバイが挙げられます。",
        "knownBy": {
          "chapter": 2,
          "verse": 9
        },
        "sourceIds": [
          "hezron_1520-webp-1ch-2-9"
        ]
      },
      {
        "textJa": "ヘツロンの子カレブと妻アズバの子らが列挙されます。",
        "knownBy": {
          "chapter": 2,
          "verse": 18
        },
        "sourceIds": [
          "hezron_1520-webp-1ch-2-18"
        ]
      },
      {
        "textJa": "ヘツロンは六十歳の時にマキルの娘と結婚し、セグブの父となったと記されます。",
        "knownBy": {
          "chapter": 2,
          "verse": 21
        },
        "sourceIds": [
          "hezron_1520-webp-1ch-2-21"
        ]
      },
      {
        "textJa": "ヘツロンの死後、妻アビヤがアシュルを産んだと記されます。",
        "knownBy": {
          "chapter": 2,
          "verse": 24
        },
        "sourceIds": [
          "hezron_1520-webp-1ch-2-24"
        ]
      },
      {
        "textJa": "ヘツロンの長子エラフメエルの子らが列挙されます。",
        "knownBy": {
          "chapter": 2,
          "verse": 25
        },
        "sourceIds": [
          "hezron_1520-webp-1ch-2-25"
        ]
      },
      {
        "textJa": "ユダの子らの一覧にもヘツロンの名が記されています。",
        "knownBy": {
          "chapter": 4,
          "verse": 1
        },
