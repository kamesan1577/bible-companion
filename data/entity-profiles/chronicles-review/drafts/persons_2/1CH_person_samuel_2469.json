    "facts": [
      {
        "textJa": "ヘマンはコハテ族の歌い手として、ヨエルの子、サムエルの子とする系譜で記されています。",
        "knownBy": {
          "chapter": 6,
          "verse": 33
        },
        "sourceIds": [
          "chronicles-person-samuel_2469-webp-1ch-6-33"
        ]
      },
      {
        "textJa": "ダビデとサムエルが門衛の職務を定めたと記されます。",
        "knownBy": {
          "chapter": 9,
          "verse": 22
        },
        "sourceIds": [
          "chronicles-person-samuel_2469-webp-1ch-9-22"
        ]
      },
      {
        "textJa": "ダビデがイスラエルの王として油を注がれたことは、主の言葉に従いサムエルを通して告げられたと記されます。",
        "knownBy": {
          "chapter": 11,
          "verse": 3
        },
        "sourceIds": [
          "chronicles-person-samuel_2469-webp-1ch-11-3"
        ]
      },
      {
        "textJa": "サムエルは先見者として、主にささげられた品の由来を示す人々の一人に挙げられます。",
        "knownBy": {
          "chapter": 26,
          "verse": 28
        },
        "sourceIds": [
          "chronicles-person-samuel_2469-webp-1ch-26-28"
        ]
      },
      {
        "textJa": "ダビデの事績を記す資料として、サムエルの歴史記録が言及されます。",
        "knownBy": {
          "chapter": 29,
          "verse": 29
        },
        "sourceIds": [
          "chronicles-person-samuel_2469-webp-1ch-29-29"
        ]
      }
    ],
