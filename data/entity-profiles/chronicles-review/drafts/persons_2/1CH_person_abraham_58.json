    "facts": [
      {
        "textJa": "子孫の系譜はイサクとイシュマエルをアブラハムの子として挙げます。",
        "knownBy": {
          "chapter": 1,
          "verse": 28
        },
        "sourceIds": [
          "chronicles-person-abraham_58-webp-1ch-1-28"
        ]
      },
      {
        "textJa": "ケトラをアブラハムのそばめとし、彼女の子らを列挙します。",
        "knownBy": {
          "chapter": 1,
          "verse": 32
        },
        "sourceIds": [
          "chronicles-person-abraham_58-webp-1ch-1-32"
        ]
      },
      {
        "textJa": "アブラハムからイサクへ、さらにエサウとイスラエルへ続く系譜を記します。",
        "knownBy": {
          "chapter": 1,
          "verse": 34
        },
        "sourceIds": [
          "chronicles-person-abraham_58-webp-1ch-1-34"
        ]
      },
      {
        "textJa": "ダビデの祈りはアブラハムとの契約とイサクへの誓いを回想します。",
        "knownBy": {
          "chapter": 16,
          "verse": 16
        },
        "sourceIds": [
          "chronicles-person-abraham_58-webp-1ch-16-16"
        ]
      },
      {
        "textJa": "ダビデの祈りで、アブラハム、イサク、イスラエルの神を呼び求めています。",
        "knownBy": {
          "chapter": 29,
          "verse": 18
        },
