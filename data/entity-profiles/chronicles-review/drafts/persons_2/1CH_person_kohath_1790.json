    "facts": [
      {
        "textJa": "コハトの子としてアムラム、イツハル、ヘブロン、ウジエルが挙げられます。",
        "knownBy": {
          "chapter": 6,
          "verse": 2
        },
        "sourceIds": [
          "webp-1ch-kohath_1790-6-2"
        ]
      },
      {
        "textJa": "コハト人の家族にはマナセ半部族からくじで十の町が与えられました。",
        "knownBy": {
          "chapter": 6,
          "verse": 61
        },
        "sourceIds": [
          "webp-1ch-kohath_1790-6-61"
        ]
      },
      {
        "textJa": "エフライム族内にもコハト人の家族の町が割り当てられます。",
        "knownBy": {
          "chapter": 6,
          "verse": 66
        },
        "sourceIds": [
          "webp-1ch-kohath_1790-6-66"
        ]
      },
      {
        "textJa": "契約の箱を担うレビ人の名簿では、コハトの子らからウリエルと兄弟たちが挙げられます。",
        "knownBy": {
          "chapter": 15,
          "verse": 5
        },
        "sourceIds": [
          "webp-1ch-kohath_1790-15-5"
        ]
      },
      {
        "textJa": "レビの家系を再掲する一覧でも、コハトの子らとしてアムラム、イツハル、ヘブロン、ウジエルが挙げられます。",
        "knownBy": {
          "chapter": 23,
          "verse": 12
        },
        "sourceIds": [
          "webp-1ch-kohath_1790-23-12"
        ]
      }
    ],
