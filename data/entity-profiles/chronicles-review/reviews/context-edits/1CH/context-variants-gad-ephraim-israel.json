            "facts": [
              {
                "textJa": "系譜はイスラエルの子らとしてルベン、シメオン、レビ、ユダ、イッサカル、ゼブルンを挙げます。",
                "knownBy": {
                  "chapter": 2,
                  "verse": 1
                },
                "sourceIds": [
                  "webp-1ch-israel_682-2-1"
                ]
              },
              {
                "textJa": "系譜は続けてダン、ヨセフ、ベニヤミン、ナフタリ、ガド、アシェルを挙げ、ここで十二人の名がそろいます。",
                "knownBy": {
                  "chapter": 2,
                  "verse": 2
                },
                "sourceIds": [
                  "webp-1ch-israel_682-2-2"
                ]
              },
              {
                "textJa": "ルベンはイスラエルの長子と記され、長子権についても説明されます。",
                "knownBy": {
                  "chapter": 5,
                  "verse": 1
                },
                "sourceIds": [
                  "webp-1ch-israel_682-5-1"
                ]
              },
              {
                "textJa": "系譜はイスラエルの子ルベンの子孫を列挙します。",
                "knownBy": {
                  "chapter": 5,
                  "verse": 3
                },
                "sourceIds": [
                  "webp-1ch-israel_682-5-3"
                ]
              },
              {
                "textJa": "レビの系譜はイスラエルまでさかのぼります。",
                "knownBy": {
                  "chapter": 6,
                  "verse": 38
                },
                "sourceIds": [
                  "webp-1ch-israel_682-6-38"
                ]
              },
              {
                "textJa": "この系譜箇所はヨセフをイスラエルの子と記します。",
                "knownBy": {
                  "chapter": 7,
                  "verse": 29
                },
                "sourceIds": [
                  "webp-1ch-israel_682-7-29"
                ]
              },
              {
                "textJa": "契約についての詩句では、イスラエルの名がヤコブと並べて記されます。",
                "knownBy": {
                  "chapter": 16,
                  "verse": 17
                },
                "sourceIds": [
                  "webp-1ch-israel_682-16-17"
                ]
              },
              {
                "textJa": "祈りの中でアブラハム、イサク、イスラエルは「先祖」と呼ばれます。",
                "knownBy": {
                  "chapter": 29,
                  "verse": 18
                },
                "sourceIds": [
                  "webp-1ch-israel_682-29-18"
                ]
              }
            ],
            "modernLocationJa": null,
            "historicalRoleJa": null,
            "coordinate": null,
            "locationNoteJa": null,
            "wikipedia": null,
            "materialCardIDs": null,
            "supplemental": false
          }
        ]
