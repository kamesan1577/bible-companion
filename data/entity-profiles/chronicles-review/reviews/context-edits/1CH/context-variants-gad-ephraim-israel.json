      "sourceCoordinateEdges": [
        {
          "book": "1CH",
          "chapter": 1,
          "verse": 34,
          "sourceId": "webp-1ch-israel_682-1-34",
          "sourceText": "Abraham became the father of Isaac. The sons of Isaac: Esau and Israel.",
          "sourceTextSHA256": "31208f70863e71ace9706fd7350192292b8bd65fb1eadbed62ffbb51de7738d2",
          "citationURL": "https://ebible.org/engwebp/1CH01.htm#V34",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "Esau and Israel are explicitly listed as Isaac’s sons."
        },
        {
          "book": "1CH",
          "chapter": 2,
          "verse": 1,
          "sourceId": "webp-1ch-israel_682-2-1",
          "sourceText": "These are the sons of Israel: Reuben, Simeon, Levi, Judah, Issachar, Zebulun,",
          "sourceTextSHA256": "ca540a9538ec383bddfdda06d66530873044633a8bfe3c1b20536e19ceb430c2",
          "citationURL": "https://ebible.org/engwebp/1CH02.htm#V1",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The genealogy explicitly introduces the sons of Israel; it is a genealogical father reference."
        },
        {
          "book": "1CH",
          "chapter": 5,
          "verse": 1,
          "sourceId": "webp-1ch-israel_682-5-1",
          "sourceText": "The sons of Reuben the firstborn of Israel (for he was the firstborn, but because he defiled his father’s couch, his birthright was given to the sons of Joseph the son of Israel; and the genealogy is not to be listed according to the birthright.",
          "sourceTextSHA256": "e2b185c50f2276b28e7417766bccc272121e0e91f73c2472bab8bd945fd32c22",
          "citationURL": "https://ebible.org/engwebp/1CH05.htm#V1",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "Reuben is explicitly identified as Israel’s firstborn."
        },
        {
          "book": "1CH",
          "chapter": 5,
          "verse": 3,
          "sourceId": "webp-1ch-israel_682-5-3",
          "sourceText": "the sons of Reuben the firstborn of Israel: Hanoch, Pallu, Hezron, and Carmi.",
          "sourceTextSHA256": "98588ad574529ebe06374601460d6f40e99b4064302b9398466dbe9dc0e1a95f",
          "citationURL": "https://ebible.org/engwebp/1CH05.htm#V3",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The Reubenite genealogy again names Israel as father."
        },
        {
          "book": "1CH",
          "chapter": 6,
          "verse": 38,
          "sourceId": "webp-1ch-israel_682-6-38",
          "sourceText": "the son of Izhar, the son of Kohath, the son of Levi, the son of Israel.",
          "sourceTextSHA256": "2f4a7b58b0994c4ecf3f958335ca120f2b78dec4bd24d72cebf981c298169411",
          "citationURL": "https://ebible.org/engwebp/1CH06.htm#V38",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The ancestry chain names Israel as the ancestor of Levi."
        },
        {
          "book": "1CH",
          "chapter": 7,
          "verse": 29,
          "sourceId": "webp-1ch-israel_682-7-29",
          "sourceText": "and by the borders of the children of Manasseh, Beth Shean and its towns, Taanach and its towns, Megiddo and its towns, and Dor and its towns. The children of Joseph the son of Israel lived in these.",
          "sourceTextSHA256": "ee2f224b69ad920cf9162f1949b72fbc8f46c1dac6a81aff48c2d03d32cfb28e",
          "citationURL": "https://ebible.org/engwebp/1CH07.htm#V29",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The verse explicitly identifies Joseph as son of Israel."
        },
        {
          "book": "1CH",
          "chapter": 16,
          "verse": 17,
          "sourceId": "webp-1ch-israel_682-16-17",
          "sourceText": "He confirmed it to Jacob for a statute, and to Israel for an everlasting covenant,",
          "sourceTextSHA256": "c697756de27c3ce21357860d4f3f7b6a593162499b61ae89b720b7d4ecd11576",
          "citationURL": "https://ebible.org/engwebp/1CH16.htm#V17",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The covenant line names Jacob and Israel in parallel as the patriarch."
        },
        {
          "book": "1CH",
          "chapter": 29,
          "verse": 18,
          "sourceId": "webp-1ch-israel_682-29-18",
          "sourceText": "LORD, the God of Abraham, of Isaac, and of Israel, our fathers, keep this desire forever in the thoughts of the heart of your people, and prepare their heart for you;",
          "sourceTextSHA256": "c04c506a367ddca75a5f3ec693bd39e35a198537a96dd416da7bfef4eb746c27",
          "citationURL": "https://ebible.org/engwebp/1CH29.htm#V18",
          "entityID": "person:israel_682",
          "relationship": "direct",
          "contextVariant": "individual-context-variant",
          "reasonJa": "The prayer explicitly calls Abraham, Isaac, and Israel “our fathers”."
        },
        {
          "book": "1CH",
          "chapter": 2,
          "verse": 2,
          "sourceId": "webp-1ch-israel_682-2-2",
          "sourceText": "Dan, Joseph, Benjamin, Naphtali, Gad, and Asher.",
          "sourceTextSHA256": "3776454b81ad749f7a150dbf7d14ed81c3c023281a3d6e48c12c310105fbf1c2",
          "citationURL": "https://ebible.org/engwebp/1CH02.htm#V2",
          "entityID": "person:israel_682",
          "relationship": "context",
          "contextVariant": "individual-context-variant",
          "reasonJa": "「イスラエルの子ら」という系譜見出しが2:1から続く文脈です。2:2は父祖名を繰り返していないため、個人の直接言及ではなく父祖の文脈として扱います。"
        }
      ],
