      "resolutionLogDraftSHA256": "4268dd92f075b3733b487038d036b569e8b95b5c8de53564f001ffe9e7836830",
      "resolutionHashMatchesCurrent": true,
      "resolutionEntry": "「ユダヤの王」を「王アグリッパ」に変更。Acts 25:13が与える称号を越えて領域を指定しない。",
      "primarySourceEvidence": [
        {
          "coordinate": "ACT 25:13",
          "sourcePath": "acts-web-verses.json",
          "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5",
          "text": "Now when some days had passed, King Agrippa and Bernice arrived at Caesarea and greeted Festus."
        }
      ],
      "independentAssessmentJa": "WEB 25:13は「King Agrippa」とだけ呼び、王位の領域を指定しない。現在のsubtitle「王アグリッパ」はこの節の範囲に合う。summaryもベルニケとカイサリアへ来てフェストに挨拶するという同節の記述に限定。",
      "resolutionAssessmentJa": "修正は現draftの文字列と実SHAで確認。Wikipedia記事はHerod Agrippa II本人を扱い、同記事の王位表記はガリラヤ等の支配を挙げており、「ユダヤの王」を避ける根拠にもなる。",
      "externalEvidence": [
        {
          "url": "https://en.wikipedia.org/wiki/Herod_Agrippa_II",
          "checkedAt": "2026-10-15",
          "identityBasisJa": "記事はHerod Agrippa IIを扱い、Acts 25–26でPaulが彼とBereniceの前で弁明したと説明。王位欄はGalilee/Pereaなどを挙げる。"
        }
      ]
    },
