      "resolutionLogDraftSHA256": "5bad664270d31f7119c451b7917711251731921fb240508da838e9d032b276c0",
      "resolutionHashMatchesCurrent": true,
      "resolutionEntry": "「大祭司の一族の人物」を尋問に立ち会った人物へ限定。Wikipedia Alexander記事のOther people > AntiquityにActs 4:6の対象人物を確認し、#Antiquity shared-sectionを設定。",
      "primarySourceEvidence": [
        {
          "coordinate": "ACT 4:5",
          "sourcePath": "acts-web-verses.json",
          "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5",
          "text": "In the morning, their rulers, elders, and scribes were gathered together in Jerusalem."
        },
        {
          "coordinate": "ACT 4:6",
          "sourcePath": "acts-web-verses.json",
          "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5",
          "text": "Annas the high priest was there, with Caiaphas, John, Alexander, and as many as were relatives of the high priest."
        },
        {
          "coordinate": "ACT 4:7",
          "sourcePath": "acts-web-verses.json",
          "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5",
          "text": "When they had stood Peter and John in the middle of them, they inquired, “By what power, or in what name, have you done this?”"
        }
      ],
      "independentAssessmentJa": "4:6はアンナス、カイアファ、ヨハネ、アレクサンドロスと大祭司の親族を挙げる。4:7でペテロとヨハネが彼らの中央に立たされ尋問される。現subtitleは「尋問に立ち会った人物」、summaryは尋問の場にいた一人として並記するだけで、アレクサンドロス自身を大祭司の親族とは断定していない。",
      "resolutionAssessmentJa": "文言が当初の過剰な親族関係を除去したことを確認。4:6–7の一連の法廷場面により「立ち会った」は文脈上裏付けられる。",
      "externalEvidence": [
        {
          "url": "https://ebible.org/engwebp/ACT04.htm#V6",
          "coordinate": "ACT 4:6",
          "noteJa": "人物列挙と「大祭司の親族」の句を確認。"
        },
        {
          "url": "https://ebible.org/engwebp/ACT04.htm#V7",
          "coordinate": "ACT 4:7",
          "noteJa": "続く尋問場面を確認。"
        }
      ]
    },
