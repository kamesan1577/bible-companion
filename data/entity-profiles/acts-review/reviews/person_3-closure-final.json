            "knownBy": {
              "chapter": 9,
              "verse": 17
            },
            "sourceIds": [
              "web-act-9-1",
              "web-act-9-4",
              "web-act-9-8",
              "web-act-9-11",
              "web-act-9-17"
            ]
          },
          {
            "textJa": "使徒言行録13:9は「サウロ、別名パウロ」と明記し、以後パウロの名を用います。",
            "knownBy": {
              "chapter": 13,
              "verse": 9
            },
            "sourceIds": [
              "web-act-13-9"
            ]
          },
          {
            "textJa": "バルナバとともに宣教旅行へ出て、各地で福音を伝えます。",
            "knownBy": {
              "chapter": 18,
              "verse": 1
            },
            "sourceIds": [
