        "identityNoteJa": "",
        "sourceIds": [
          "web-act-7-58"
        ],
        "facts": [
          {
            "textJa": "サウロはステパノの殺害に賛成します。さらに家々に押し入り、男女を問わず信者を引き出して牢に送ります。",
            "knownBy": {
              "chapter": 8,
              "verse": 3
