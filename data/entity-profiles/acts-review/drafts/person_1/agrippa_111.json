    "facts": [
      {
        "textJa": "アグリッパはフェストに、パウロ本人の話を聞きたいと伝える。",
        "knownBy": {
          "chapter": 25,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-25-22"
        ]
      },
      {
        "textJa": "翌日、アグリッパとベルニケは盛装して謁見の場に入り、パウロが連れて来られる。",
        "knownBy": {
          "chapter": 25,
          "verse": 23
        },
        "sourceIds": [
          "webp-acts-25-23"
        ]
      },
      {
        "textJa": "フェストは、パウロについて集まったユダヤ人たちが彼を生かしておくべきでないと訴えたと説明する。",
        "knownBy": {
          "chapter": 25,
          "verse": 24
        },
        "sourceIds": [
          "webp-acts-25-24"
        ]
      },
      {
        "textJa": "フェストは皇帝に送る確かな報告内容を得るため、アグリッパの前にパウロを出したと述べる。",
        "knownBy": {
          "chapter": 25,
          "verse": 26
        },
        "sourceIds": [
          "webp-acts-25-26"
        ]
      },
      {
        "textJa": "アグリッパはパウロに自分のために弁明するよう許可する。",
        "knownBy": {
          "chapter": 26,
          "verse": 1
        },
        "sourceIds": [
          "webp-acts-26-1"
        ]
      },
      {
        "textJa": "パウロは、ユダヤ人たちの告発について王の前で弁明できることを喜ぶ。",
        "knownBy": {
          "chapter": 26,
          "verse": 2
        },
        "sourceIds": [
          "webp-acts-26-2"
        ]
      },
      {
        "textJa": "パウロは、イスラエル十二部族が昼も夜も神に仕えて望む希望を理由に訴えられていると語る。",
        "knownBy": {
          "chapter": 26,
          "verse": 7
        },
        "sourceIds": [
          "webp-acts-26-7"
        ]
      },
      {
        "textJa": "パウロは、天からの幻に従ったとアグリッパに語る。",
        "knownBy": {
          "chapter": 26,
          "verse": 19
        },
        "sourceIds": [
          "webp-acts-26-19"
        ]
      },
      {
        "textJa": "パウロは、アグリッパに預言者を信じるかと問いかける。",
        "knownBy": {
          "chapter": 26,
          "verse": 27
        },
        "sourceIds": [
          "webp-acts-26-27"
        ]
      },
      {
        "textJa": "アグリッパは、短い説得で自分をキリスト者にしようとしているのかと応じる。",
        "knownBy": {
          "chapter": 26,
          "verse": 28
        },
        "sourceIds": [
          "webp-acts-26-28"
        ]
      },
      {
        "textJa": "アグリッパはフェストに、パウロが皇帝に上訴していなければ釈放できたはずだと語る。",
        "knownBy": {
          "chapter": 26,
          "verse": 32
        },
        "sourceIds": [
          "webp-acts-26-32"
        ]
      }
    ],
