    "facts": [
      {
        "textJa": "千人隊長クラウディウス・リュシアはフェリクスに書簡を送る。",
        "knownBy": {
          "chapter": 23,
          "verse": 26
        },
        "sourceIds": [
          "webp-acts-23-26"
        ]
      },
      {
        "textJa": "弁護士テルティロはフェリクスの統治を称賛して告発を始める。",
        "knownBy": {
          "chapter": 24,
          "verse": 3
        },
        "sourceIds": [
          "webp-acts-24-3"
        ]
      },
      {
        "textJa": "フェリクスは「この道」について詳しく知っていたので審理を延期する。",
        "knownBy": {
          "chapter": 24,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-24-22"
        ]
      },
      {
        "textJa": "フェリクスは妻ドルシラとともにパウロの話を聞く。",
        "knownBy": {
          "chapter": 24,
          "verse": 24
        },
        "sourceIds": [
          "webp-acts-24-24"
        ]
      },
      {
        "textJa": "フェリクスは義、公正、節制、来るべき裁きについて聞いて恐れ、別の機会に呼ぶと言う。",
        "knownBy": {
          "chapter": 24,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-24-25"
        ]
      },
      {
        "textJa": "二年後、フェリクスの後任としてポルキオ・フェストが就任し、フェリクスはパウロを拘束したままにする。",
        "knownBy": {
          "chapter": 24,
          "verse": 27
        },
        "sourceIds": [
          "webp-acts-24-27"
        ]
      },
      {
        "textJa": "フェストはフェリクスが残した囚人としてパウロの件をアグリッパに説明する。",
        "knownBy": {
          "chapter": 25,
          "verse": 14
        },
        "sourceIds": [
          "webp-acts-25-14"
        ]
      }
    ],
