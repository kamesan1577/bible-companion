    "facts": [
      {
        "textJa": "ペトロは、神がアブラハムに告げた契約を引用し、地上の諸氏族がその子孫を通して祝福されると述べる。",
        "knownBy": {
          "chapter": 3,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-3-25"
        ]
      },
      {
        "textJa": "ステファノは、アブラハムがハランに住む前、メソポタミアにいた時に神の栄光が現れたと語る。",
        "knownBy": {
          "chapter": 7,
          "verse": 2
        },
        "sourceIds": [
          "webp-acts-7-2"
        ]
      },
      {
        "textJa": "ステファノは、アブラハムが割礼の契約を受け、イサクの父となったと述べる。",
        "knownBy": {
          "chapter": 7,
          "verse": 8
        },
        "sourceIds": [
          "webp-acts-7-8"
        ]
      },
      {
        "textJa": "ステファノの回想では、アブラハムがシェケムのハモルの子らから銀で買った墓に遺体が葬られたとされる。",
        "knownBy": {
          "chapter": 7,
          "verse": 16
        },
        "sourceIds": [
          "webp-acts-7-16"
        ]
      },
      {
        "textJa": "ステファノは、アブラハムに誓われた約束の時が近づくにつれて、民がエジプトで増えたと語る。",
        "knownBy": {
          "chapter": 7,
          "verse": 17
        },
        "sourceIds": [
          "webp-acts-7-17"
        ]
      },
      {
        "textJa": "ステファノの引用する声は、自らをアブラハム、イサク、ヤコブの神と名乗る。",
        "knownBy": {
          "chapter": 7,
          "verse": 32
        },
        "sourceIds": [
          "webp-acts-7-32"
        ]
      },
      {
        "textJa": "パウロは、アブラハムの一族と神を畏れる人々に救いの言葉が送られたと語る。",
        "knownBy": {
          "chapter": 13,
          "verse": 26
        },
        "sourceIds": [
          "webp-acts-13-26"
        ]
      }
    ],
