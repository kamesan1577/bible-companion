    "facts": [
      {
        "textJa": "バルナバは畑を売り、その代金を使徒たちのもとに持って来た。",
        "knownBy": {
          "chapter": 4,
          "verse": 37
        },
        "sourceIds": [
          "webp-acts-4-37"
        ]
      },
      {
        "textJa": "バルナバはサウロを使徒たちのもとへ連れて行き、彼が主を見たことやダマスコで大胆に語ったことを説明した。",
        "knownBy": {
          "chapter": 9,
          "verse": 27
        },
        "sourceIds": [
          "webp-acts-9-27"
        ]
      },
      {
        "textJa": "エルサレム教会はアンティオキアへバルナバを派遣した。",
        "knownBy": {
          "chapter": 11,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-11-22"
        ]
      },
      {
        "textJa": "バルナバはサウロを探しにタルソへ行った。",
        "knownBy": {
          "chapter": 11,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-11-25"
        ]
      },
      {
        "textJa": "バルナバとサウロは救援物資を長老たちへ届けた。",
        "knownBy": {
          "chapter": 11,
          "verse": 30
        },
        "sourceIds": [
          "webp-acts-11-30"
        ]
      },
      {
        "textJa": "バルナバとサウロは任務を終えてエルサレムから戻った。",
        "knownBy": {
          "chapter": 12,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-12-25"
        ]
      },
      {
        "textJa": "バルナバはアンティオキア教会の預言者・教師たちの一人として挙げられる。",
        "knownBy": {
          "chapter": 13,
          "verse": 1
        },
        "sourceIds": [
          "webp-acts-13-1"
        ]
      },
      {
        "textJa": "聖霊の指示を受け、バルナバとサウロが宣教のために送り出された。",
        "knownBy": {
          "chapter": 13,
          "verse": 2
        },
        "sourceIds": [
          "webp-acts-13-2"
        ]
      },
      {
        "textJa": "バルナバとサウロはキプロス総督セルギオ・パウロに呼ばれ、神の言葉を伝えた。",
        "knownBy": {
          "chapter": 13,
          "verse": 7
        },
        "sourceIds": [
          "webp-acts-13-7"
        ]
      },
      {
        "textJa": "バルナバとパウロは会堂での集まりの後、多くの人々に神の恵みにとどまるよう勧めた。",
        "knownBy": {
          "chapter": 13,
          "verse": 43
        },
        "sourceIds": [
          "webp-acts-13-43"
        ]
      },
      {
        "textJa": "バルナバとパウロは、神の言葉をまずユダヤ人に語る必要があったと説明する。",
        "knownBy": {
          "chapter": 13,
          "verse": 46
        },
        "sourceIds": [
          "webp-acts-13-46"
        ]
      },
      {
        "textJa": "反対者たちはバルナバとパウロを地域から追い出した。",
        "knownBy": {
          "chapter": 13,
          "verse": 50
        },
        "sourceIds": [
          "webp-acts-13-50"
        ]
      },
      {
        "textJa": "群衆はバルナバをゼウス、パウロをヘルメスと呼んだ。",
        "knownBy": {
          "chapter": 14,
          "verse": 12
        },
        "sourceIds": [
          "webp-acts-14-12"
        ]
      },
      {
        "textJa": "バルナバとパウロは衣を裂き、群衆に自分たちは人間だと訴えた。",
        "knownBy": {
          "chapter": 14,
          "verse": 14
        },
        "sourceIds": [
          "webp-acts-14-14"
        ]
      },
      {
        "textJa": "バルナバはパウロとともに翌日デルベへ向かった。",
        "knownBy": {
          "chapter": 14,
          "verse": 20
        },
        "sourceIds": [
          "webp-acts-14-20"
        ]
      },
      {
        "textJa": "バルナバとパウロは割礼をめぐる争いをエルサレムで協議するため派遣された。",
        "knownBy": {
          "chapter": 15,
          "verse": 2
        },
        "sourceIds": [
          "webp-acts-15-2"
        ]
      },
      {
        "textJa": "バルナバとパウロは、異邦人の間で起きたしるしを報告した。",
        "knownBy": {
          "chapter": 15,
          "verse": 12
        },
        "sourceIds": [
          "webp-acts-15-12"
        ]
      },
      {
        "textJa": "使徒・長老たちはバルナバとパウロをアンティオキアへ送ることを決めた。",
        "knownBy": {
          "chapter": 15,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-15-22"
        ]
      },
      {
        "textJa": "バルナバとパウロはアンティオキアにとどまり教えた。",
        "knownBy": {
          "chapter": 15,
          "verse": 35
        },
        "sourceIds": [
          "webp-acts-15-35"
        ]
      },
      {
        "textJa": "パウロは、訪問した町々の兄弟たちを再訪しようと提案した。",
        "knownBy": {
          "chapter": 15,
          "verse": 36
        },
        "sourceIds": [
          "webp-acts-15-36"
        ]
      },
      {
        "textJa": "バルナバはマルコも連れて行くことを望んだ。",
        "knownBy": {
          "chapter": 15,
          "verse": 37
        },
        "sourceIds": [
          "webp-acts-15-37"
        ]
      },
      {
        "textJa": "二人は意見が激しく食い違い、バルナバはマルコとキプロスへ出航した。",
        "knownBy": {
          "chapter": 15,
          "verse": 39
        },
        "sourceIds": [
          "webp-acts-15-39"
        ]
      }
    ],
