    "facts": [
      {
        "textJa": "コルネリウスは敬虔で、家族とともに神を畏れ、貧しい人々に施しをし、いつも神に祈っていた。",
        "knownBy": {
          "chapter": 10,
          "verse": 2
        },
        "sourceIds": [
          "webp-acts-10-2"
        ]
      },
      {
        "textJa": "コルネリウスは午後の幻で、神の使いから名を呼ばれる。",
        "knownBy": {
          "chapter": 10,
          "verse": 3
        },
        "sourceIds": [
          "webp-acts-10-3"
        ]
      },
      {
        "textJa": "コルネリウスは幻を見た後、二人の召使いと敬虔な兵士をヨッパへ遣わす。",
        "knownBy": {
          "chapter": 10,
          "verse": 7
        },
        "sourceIds": [
          "webp-acts-10-7"
        ]
      },
      {
        "textJa": "ペテロが幻の意味を考えている間、コルネリウスの使者たちは家を尋ね当てて門に立つ。",
        "knownBy": {
          "chapter": 10,
          "verse": 17
        },
        "sourceIds": [
          "webp-acts-10-17"
        ]
      },
      {
        "textJa": "ペテロはコルネリウスから遣わされた人々に自分が探していた人物だと告げる。",
        "knownBy": {
          "chapter": 10,
          "verse": 21
        },
        "sourceIds": [
          "webp-acts-10-21"
        ]
      },
      {
        "textJa": "使者たちは、コルネリウスが正しい人で神を畏れ、ユダヤ人にも評判がよいと説明する。",
        "knownBy": {
          "chapter": 10,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-10-22"
        ]
      },
      {
        "textJa": "翌日、コルネリウスは親族や親しい友人を集めてペテロを待つ。",
        "knownBy": {
          "chapter": 10,
          "verse": 24
        },
        "sourceIds": [
          "webp-acts-10-24"
        ]
      },
      {
        "textJa": "コルネリウスはペテロを迎え、足元にひれ伏す。",
        "knownBy": {
          "chapter": 10,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-10-25"
        ]
      },
      {
        "textJa": "コルネリウスは祈っていた時に見た幻をペテロに説明する。",
        "knownBy": {
          "chapter": 10,
          "verse": 30
        },
        "sourceIds": [
          "webp-acts-10-30"
        ]
      },
      {
        "textJa": "使いはコルネリウスに、祈りが聞かれ施しが覚えられたと告げた。",
        "knownBy": {
          "chapter": 10,
          "verse": 31
        },
        "sourceIds": [
          "webp-acts-10-31"
        ]
      }
    ],
