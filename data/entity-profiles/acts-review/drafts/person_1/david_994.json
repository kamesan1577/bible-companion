    "facts": [
      {
        "textJa": "ペテロは、ダビデが主を常に自分の前に見たと記した詩を引用する。",
        "knownBy": {
          "chapter": 2,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-2-25"
        ]
      },
      {
        "textJa": "ペテロは、族長ダビデが死んで葬られ、その墓が当時まであったと述べる。",
        "knownBy": {
          "chapter": 2,
          "verse": 29
        },
        "sourceIds": [
          "webp-acts-2-29"
        ]
      },
      {
        "textJa": "ペテロは、ダビデ自身は天に上らなかったと述べ、詩篇の言葉を引用する。",
        "knownBy": {
          "chapter": 2,
          "verse": 34
        },
        "sourceIds": [
          "webp-acts-2-34"
        ]
      },
      {
        "textJa": "信徒たちは、神が聖霊によって僕ダビデの口を通し、諸国民の反抗を語ったと祈る。",
        "knownBy": {
          "chapter": 4,
          "verse": 25
        },
        "sourceIds": [
          "webp-acts-4-25"
        ]
      },
      {
        "textJa": "ステファノは、ヨシュアの時代からダビデの時代まで幕屋が受け継がれたと語る。",
        "knownBy": {
          "chapter": 7,
          "verse": 45
        },
        "sourceIds": [
          "webp-acts-7-45"
        ]
      },
      {
        "textJa": "パウロは、神がサウルを退けた後ダビデを王に立て、彼を御心にかなう人と評したと語る。",
        "knownBy": {
          "chapter": 13,
          "verse": 22
        },
        "sourceIds": [
          "webp-acts-13-22"
        ]
      },
      {
        "textJa": "パウロは、イエスを死者の中から復活させたことを、ダビデへの約束と結び付ける。",
        "knownBy": {
          "chapter": 13,
          "verse": 34
        },
        "sourceIds": [
          "webp-acts-13-34"
        ]
      },
      {
        "textJa": "パウロは、ダビデが自分の時代に神の意志に仕えた後に死んだと述べる。",
        "knownBy": {
          "chapter": 13,
          "verse": 36
        },
        "sourceIds": [
          "webp-acts-13-36"
        ]
      },
      {
        "textJa": "ヤコブは、ダビデの倒れた幕屋を建て直すという預言を引用する。",
        "knownBy": {
          "chapter": 15,
          "verse": 16
        },
        "sourceIds": [
          "webp-acts-15-16"
        ]
      }
    ],
