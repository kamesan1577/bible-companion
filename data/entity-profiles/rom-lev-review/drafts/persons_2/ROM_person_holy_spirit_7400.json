    "facts": [
      {
        "textJa": "キリスト・イエスにある者は、肉に従わず霊に従って歩むと述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 1
        },
        "sourceIds": [
          "webp-rom-08-01"
        ]
      },
      {
        "textJa": "キリスト・イエスにある命の霊の法則が、罪と死の法則から解放したと述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 2
        },
        "sourceIds": [
          "webp-rom-08-02"
        ]
      },
      {
        "textJa": "律法の要求が、肉ではなく霊に従って歩む者たちのうちに満たされると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 4
        },
        "sourceIds": [
          "webp-rom-08-04"
        ]
      },
      {
        "textJa": "肉に従う者と霊に従う者の思いの違いが述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 5
        },
        "sourceIds": [
          "webp-rom-08-05"
        ]
      },
      {
        "textJa": "神の霊が信徒のうちに住むこと、またキリストの霊を持つことが述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 9
        },
        "sourceIds": [
          "webp-rom-08-09"
        ]
      },
      {
        "textJa": "イエスを死者の中からよみがえらせた方の霊が信徒のうちに住み、死ぬべき体に命を与えると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 11
        },
        "sourceIds": [
          "webp-rom-08-11"
        ]
      },
      {
        "textJa": "霊によって体の行いを殺すなら生きると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 13
        },
        "sourceIds": [
          "webp-rom-08-13"
        ]
      },
      {
        "textJa": "神の霊に導かれる人々は神の子どもであると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 14
        },
        "sourceIds": [
          "webp-rom-08-14"
        ]
      },
      {
        "textJa": "受けたのは恐れに戻す奴隷の霊ではなく、子とする霊であると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 15
        },
        "sourceIds": [
          "webp-rom-08-15"
        ]
      },
      {
        "textJa": "霊が、信徒が神の子どもであることを彼らの霊とともに証しすると述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 16
        },
        "sourceIds": [
          "webp-rom-08-16"
        ]
      },
      {
        "textJa": "信徒たちは霊の初穂を持ち、体の贖いを待ち望むと述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 23
        },
        "sourceIds": [
          "webp-rom-08-23"
        ]
      },
      {
        "textJa": "霊が弱さを助け、言葉にできないうめきをもって執り成すと述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 26
        },
        "sourceIds": [
          "webp-rom-08-26"
        ]
      },
      {
        "textJa": "心を探る方は霊の思いを知り、霊は聖徒のために執り成すと述べられる。",
        "knownBy": {
          "chapter": 8,
          "verse": 27
        },
        "sourceIds": [
          "webp-rom-08-27"
        ]
      },
      {
        "textJa": "パウロの良心が聖霊にあって証しすると述べられる。",
        "knownBy": {
          "chapter": 9,
          "verse": 1
        },
        "sourceIds": [
          "webp-rom-09-01"
        ]
      },
      {
        "textJa": "神の国は、聖霊にある義と平和と喜びだと述べられる。",
        "knownBy": {
          "chapter": 14,
          "verse": 17
        },
        "sourceIds": [
          "webp-rom-14-17"
        ]
      },
      {
        "textJa": "信徒が聖霊の力によって希望にあふれるよう祈られる。",
        "knownBy": {
          "chapter": 15,
          "verse": 13
        },
        "sourceIds": [
          "webp-rom-15-13"
        ]
      },
      {
        "textJa": "異邦人の献げ物が聖霊によって聖なるものとされると述べられる。",
        "knownBy": {
          "chapter": 15,
          "verse": 16
        },
        "sourceIds": [
          "webp-rom-15-16"
        ]
      },
      {
        "textJa": "福音が神の霊の力によってしるしと不思議を伴って伝えられたと述べられる。",
        "knownBy": {
          "chapter": 15,
          "verse": 19
        },
        "sourceIds": [
          "webp-rom-15-19"
        ]
      },
      {
        "textJa": "パウロは主イエス・キリストと霊の愛によって、ともに祈るよう願う。",
        "knownBy": {
          "chapter": 15,
          "verse": 30
        },
        "sourceIds": [
          "webp-rom-15-30"
        ]
      }
    ],
