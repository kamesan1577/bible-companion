    "primaryWitnesses": [
      {
        "ref": "ROM 5:5",
        "textualBasisJa": "and hope doesn’t disappoint us, because God’s love has been poured into our hearts through the Holy Spirit who was given to us."
      },
      {
        "ref": "ROM 8:1",
        "textualBasisJa": "There is therefore now no condemnation to those who are in Christ Jesus, who don’t walk according to the flesh, but according to the Spirit."
      },
      {
        "ref": "ROM 8:2",
        "textualBasisJa": "For the law of the Spirit of life in Christ Jesus made me free from the law of sin and of death."
      },
      {
        "ref": "ROM 8:4",
        "textualBasisJa": "that the ordinance of the law might be fulfilled in us who don’t walk according to the flesh, but according to the Spirit."
      },
      {
        "ref": "ROM 8:5",
        "textualBasisJa": "For those who live according to the flesh set their minds on the things of the flesh, but those who live according to the Spirit, the things of the Spirit."
      }
    ],
