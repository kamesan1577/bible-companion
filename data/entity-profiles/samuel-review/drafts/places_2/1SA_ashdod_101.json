    "primaryWitnesses": [
      {
        "ref": "1SA 5:1",
        "textualBasisJa": "Now the Philistines had taken God’s ark, and they brought it from Ebenezer to Ashdod.",
        "citationURL": "https://ebible.org/engwebp/1SA05.htm#V1",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      },
      {
        "ref": "1SA 5:3",
        "textualBasisJa": "When the people of Ashdod arose early on the next day, behold, Dagon had fallen on his face to the ground before the LORD’s ark. They took Dagon and set him in his place again.",
        "citationURL": "https://ebible.org/engwebp/1SA05.htm#V3",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      },
      {
        "ref": "1SA 5:5",
        "textualBasisJa": "Therefore neither the priests of Dagon nor any who come into Dagon’s house step on the threshold of Dagon in Ashdod to this day.",
        "citationURL": "https://ebible.org/engwebp/1SA05.htm#V5",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      },
      {
        "ref": "1SA 5:6",
        "textualBasisJa": "But the LORD’s hand was heavy on the people of Ashdod, and he destroyed them and struck them with tumors, even Ashdod and its borders.",
        "citationURL": "https://ebible.org/engwebp/1SA05.htm#V6",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      },
      {
        "ref": "1SA 5:7",
        "textualBasisJa": "When the men of Ashdod saw that it was so, they said, “The ark of the God of Israel shall not stay with us, for his hand is severe on us and on Dagon our god.”",
        "citationURL": "https://ebible.org/engwebp/1SA05.htm#V7",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      },
      {
        "ref": "1SA 6:17",
        "textualBasisJa": "These are the golden tumors which the Philistines returned for a trespass offering to the LORD: for Ashdod one, for Gaza one, for Ashkelon one, for Gath one, for Ekron one;",
        "citationURL": "https://ebible.org/engwebp/1SA06.htm#V17",
        "sourceVersion": "webp-usfx-2026-10-13-35a6adf626e5"
      }
    ],
