    "facts": [
      {
        "textJa": "ダビデとその部下たちは、サウルとヨナタン、イスラエルの民が剣に倒れたことを悼みました。",
        "knownBy": {
          "chapter": 1,
          "verse": 12
        },
        "sourceIds": [
          "webp-2sa-1-12"
        ]
      },
      {
        "textJa": "アブネルはサウルの子イシュ・ボシェテをマハナイムへ連れて行き、イスラエルの王としました。",
        "knownBy": {
          "chapter": 2,
          "verse": 10
        },
        "sourceIds": [
          "webp-2sa-2-8",
          "webp-2sa-2-10"
        ]
      },
      {
        "textJa": "ヨナタンの子メフィボシェトは、サウル家の土地を受け継ぐ者として記されます。",
        "knownBy": {
          "chapter": 9,
          "verse": 13
        },
        "sourceIds": [
          "webp-2sa-4-4",
          "webp-2sa-9-13"
        ]
      },
      {
        "textJa": "サウル家のシムイはダビデを呪い、後に赦しを求めました。",
        "knownBy": {
          "chapter": 19,
          "verse": 19
        },
        "sourceIds": [
          "webp-2sa-16-5",
          "webp-2sa-19-18",
          "webp-2sa-19-19"
        ]
      }
    ],
