    "facts": [
      {
        "textJa": "アビヤタルはダビデに、サウルが主の祭司たちを殺したと伝えました。",
        "knownBy": {
          "chapter": 22,
          "verse": 21
        },
        "sourceIds": [
          "webp-1sa-22-21"
        ]
      },
      {
        "textJa": "ダビデは、アビヤタルの父の家の人々が死んだことについて、自分にも責任があると語りました。",
        "knownBy": {
          "chapter": 22,
          "verse": 22
        },
        "sourceIds": [
          "webp-1sa-22-22"
        ]
      },
      {
        "textJa": "ダビデがケイラにいた時、アビヤタルはエフォドを持って彼のもとへ来たと記されます。",
        "knownBy": {
          "chapter": 23,
          "verse": 6
        },
        "sourceIds": [
          "webp-1sa-23-6"
        ]
      },
      {
        "textJa": "ダビデは祭司アビヤタルにエフォドを持って来るよう求めました。",
        "knownBy": {
          "chapter": 23,
          "verse": 9
        },
        "sourceIds": [
          "webp-1sa-23-9"
        ]
      },
      {
        "textJa": "ツィクラグで略奪を受けた後、ダビデは祭司アビヤタルにエフォドを求めました。",
        "knownBy": {
          "chapter": 30,
