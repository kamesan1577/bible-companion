    "facts": [
      {
        "textJa": "エルカナはハンナを愛し、主が彼女の胎を閉ざしていたと本文は述べます。",
        "knownBy": {
          "chapter": 1,
          "verse": 5
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-1-5"
        ]
      },
      {
        "textJa": "ハンナは心の中で祈り、エリは声が聞こえないため彼女を酔っていると思いました。",
        "knownBy": {
          "chapter": 1,
          "verse": 13
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-1-13"
        ]
      },
      {
        "textJa": "ハンナは男の子を産み、主に願い求めたことからサムエルと名づけました。",
        "knownBy": {
          "chapter": 1,
          "verse": 20
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-1-19",
          "person-hannah_1400-webp-1sa-1-20"
        ]
      },
      {
        "textJa": "乳離れした後、ハンナは子を主に仕えるため連れて行くと夫に告げます。",
        "knownBy": {
          "chapter": 1,
          "verse": 22
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-1-22"
        ]
      },
      {
        "textJa": "ハンナは祈りの中で主を喜び、救いを歌います。",
        "knownBy": {
          "chapter": 2,
          "verse": 1
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-2-1"
        ]
      },
      {
        "textJa": "主がハンナを顧み、彼女はさらに三人の息子と二人の娘を産みます。",
        "knownBy": {
          "chapter": 2,
          "verse": 21
        },
        "sourceIds": [
          "person-hannah_1400-webp-1sa-2-21"
        ]
      }
    ],
