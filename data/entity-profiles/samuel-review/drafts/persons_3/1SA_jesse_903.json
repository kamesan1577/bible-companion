    "facts": [
      {
        "textJa": "エッサイはベツレヘム人です。",
        "knownBy": {
          "chapter": 16,
          "verse": 1
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-16-1"
        ]
      },
      {
        "textJa": "エッサイには羊の番をしている末の子がいました。",
        "knownBy": {
          "chapter": 16,
          "verse": 11
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-16-11"
        ]
      },
      {
        "textJa": "本文はダビデをエッサイの子と明記します。",
        "knownBy": {
          "chapter": 16,
          "verse": 19
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-16-19"
        ]
      },
      {
        "textJa": "エッサイはダビデに、兄たちのための炒り麦一エパとパン十個を持って行くよう頼みました。",
        "knownBy": {
          "chapter": 17,
          "verse": 17
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-17-17"
        ]
      },
      {
        "textJa": "エッサイはベツレヘム人で、八人の息子がいました。",
        "knownBy": {
          "chapter": 17,
          "verse": 12
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-17-12"
        ]
      },
      {
        "textJa": "エッサイの三人の年長の息子は、サウルに従って戦場へ行っていました。",
        "knownBy": {
          "chapter": 17,
          "verse": 13
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-17-13"
        ]
      },
      {
        "textJa": "エッサイの三人の年長の息子は、サウルに従って戦場へ行っていました。",
        "knownBy": {
          "chapter": 17,
          "verse": 13
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-17-13"
        ]
      },
      {
        "textJa": "エッサイの三人の年長の息子は、サウルに従って戦場へ行っていました。",
        "knownBy": {
          "chapter": 17,
          "verse": 13
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-17-13"
        ]
      },
      {
        "textJa": "サウルは家臣たちに、エッサイの子が土地や役職を与えられるかと問いかけました。",
        "knownBy": {
          "chapter": 22,
          "verse": 7
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-22-7"
        ]
      },
      {
        "textJa": "サウルは、家臣たちが自分に逆らってダビデを助けたと責めました。",
        "knownBy": {
          "chapter": 22,
          "verse": 8
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-22-8"
        ]
      },
      {
        "textJa": "サウルはアヒメレクがエッサイの子と共謀したと非難しました。",
        "knownBy": {
          "chapter": 22,
          "verse": 13
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-22-13"
        ]
      },
      {
        "textJa": "サウルは、家臣たちが自分に逆らってダビデを助けたと責めました。",
        "knownBy": {
          "chapter": 22,
          "verse": 8
        },
        "sourceIds": [
          "person-jesse_903-webp-1sa-22-8"
        ]
      },
      {
