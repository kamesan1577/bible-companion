    "facts": [
      {
        "textJa": "本文はタマルをアムノンの妹と呼び、彼の思い悩みを記します。",
        "knownBy": {
          "chapter": 13,
          "verse": 2
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-2"
        ]
      },
      {
        "textJa": "ダビデはタマルに、兄アムノンの家で食事を用意するよう伝えます。",
        "knownBy": {
          "chapter": 13,
          "verse": 7
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-7"
        ]
      },
      {
        "textJa": "タマルはアムノンのもとで食事を作ります。",
        "knownBy": {
          "chapter": 13,
          "verse": 8
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-8"
        ]
      },
      {
        "textJa": "タマルは焼いた菓子をアムノンの部屋へ運びます。",
        "knownBy": {
          "chapter": 13,
          "verse": 10
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-10"
        ]
      },
      {
        "textJa": "タマルは灰をかぶり、衣を裂いて泣きながら去ります。",
        "knownBy": {
          "chapter": 13,
          "verse": 19
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-19"
        ]
      },
      {
        "textJa": "アブサロムはタマルを自宅に住まわせます。",
        "knownBy": {
          "chapter": 13,
          "verse": 20
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-20"
        ]
      },
      {
        "textJa": "本文はアブサロムがタマルのことでアムノンを憎んでいたと述べます。",
        "knownBy": {
          "chapter": 13,
          "verse": 22
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-22"
        ]
      },
      {
        "textJa": "ヨナダブは、タマルへの行為をめぐるアブサロムの計画について述べます。",
        "knownBy": {
          "chapter": 13,
          "verse": 32
        },
        "sourceIds": [
          "person-tamar_2822-webp-2sa-13-32"
        ]
      }
    ],
