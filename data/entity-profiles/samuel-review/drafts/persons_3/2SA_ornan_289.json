    "facts": [
      {
        "textJa": "預言者ガドはダビデに、アラウナの脱穀場に祭壇を築くよう告げます。",
        "knownBy": {
          "chapter": 24,
          "verse": 18
        },
        "sourceIds": [
          "person-ornan_289-webp-2sa-24-18"
        ]
      },
      {
        "textJa": "アラウナは王と家臣が来るのを見て、地にひれ伏します。",
        "knownBy": {
          "chapter": 24,
          "verse": 20
        },
        "sourceIds": [
          "person-ornan_289-webp-2sa-24-20"
        ]
      },
      {
        "textJa": "アラウナは牛やそりなどを王に差し出そうとします。",
        "knownBy": {
          "chapter": 24,
          "verse": 22
        },
        "sourceIds": [
          "person-ornan_289-webp-2sa-24-22"
        ]
      },
      {
        "textJa": "アラウナはすべてを王に与えると述べ、主が王を受け入れるよう願います。",
        "knownBy": {
          "chapter": 24,
          "verse": 23
        },
        "sourceIds": [
          "person-ornan_289-webp-2sa-24-23"
        ]
      },
      {
        "textJa": "ダビデは代価を払って脱穀場と牛を買います。",
        "knownBy": {
          "chapter": 24,
          "verse": 24
        },
        "sourceIds": [
          "person-ornan_289-webp-2sa-24-24"
        ]
      }
