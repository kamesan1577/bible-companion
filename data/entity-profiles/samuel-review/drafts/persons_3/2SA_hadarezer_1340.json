    "facts": [
      {
        "textJa": "ダビデはハダデゼルの家臣から金の盾を取り、ベタハとベロタイから青銅を得ました。",
        "knownBy": {
          "chapter": 8,
          "verse": 8
        },
        "sourceIds": [
          "person-hadarezer_1340-webp-2sa-8-7",
          "person-hadarezer_1340-webp-2sa-8-8"
        ]
      },
      {
        "textJa": "ハマトのトイは、ハダデゼルとの戦いを聞いて息子ヨラムをダビデに遣わし、贈り物を届けました。",
        "knownBy": {
          "chapter": 8,
          "verse": 10
        },
        "sourceIds": [
          "person-hadarezer_1340-webp-2sa-8-9",
          "person-hadarezer_1340-webp-2sa-8-10"
        ]
      },
      {
        "textJa": "ハダデゼルの戦利品は、ダビデが得た品々の一部として挙げられます。",
        "knownBy": {
          "chapter": 8,
          "verse": 12
        },
        "sourceIds": [
          "person-hadarezer_1340-webp-2sa-8-12"
        ]
      },
      {
        "textJa": "ハダデゼルはユーフラテス川の向こうのシリア人を招集し、ヘラムへ送ったと記されています。",
        "knownBy": {
          "chapter": 10,
          "verse": 16
        },
        "sourceIds": [
          "person-hadarezer_1340-webp-2sa-10-16"
        ]
      },
      {
        "textJa": "ハダデゼルに仕えていた王たちはイスラエルと和を結び、以後シリア人はアンモン人を助けなくなりました。",
        "knownBy": {
          "chapter": 10,
          "verse": 19
        },
        "sourceIds": [
          "person-hadarezer_1340-webp-2sa-10-19"
        ]
      }
    ],
