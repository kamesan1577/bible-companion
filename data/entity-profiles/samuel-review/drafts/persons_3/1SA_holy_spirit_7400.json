    "facts": [
      {
        "textJa": "サウルに主の霊が力強く臨み、彼は預言します。",
        "knownBy": {
          "chapter": 10,
          "verse": 10
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-10-10"
        ]
      },
      {
        "textJa": "主の霊がサウルに力強く臨み、彼の怒りが燃え上がります。",
        "knownBy": {
          "chapter": 11,
          "verse": 6
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-11-6"
        ]
      },
      {
        "textJa": "サムエルがダビデに油を注ぐと、主の霊がその日から力強く臨みます。",
        "knownBy": {
          "chapter": 16,
          "verse": 13
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-16-13"
        ]
      },
      {
        "textJa": "主の霊はサウルから去り、主からの悪い霊が彼を悩ませます。",
        "knownBy": {
          "chapter": 16,
          "verse": 14
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-16-14"
        ]
      },
      {
        "textJa": "サウルが送った使者たちにも、神の霊が臨み、彼らも預言します。",
        "knownBy": {
          "chapter": 19,
          "verse": 20
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-19-20"
        ]
      },
      {
        "textJa": "サウルにも神の霊が臨み、彼は預言しながら進みます。",
        "knownBy": {
          "chapter": 19,
          "verse": 23
        },
        "sourceIds": [
          "person-holy_spirit_7400-webp-1sa-19-23"
        ]
      }
    ],
