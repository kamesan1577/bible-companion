    "facts": [
      {
        "textJa": "イシュ・ボシェテはイスラエルの王となり、四十歳で即位して二年間治めました。",
        "knownBy": {
          "chapter": 2,
          "verse": 10
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-2-10"
        ]
      },
      {
        "textJa": "アブネルとイシュ・ボシェテの家臣たちはマハナイムからギブオンへ出て行きました。",
        "knownBy": {
          "chapter": 2,
          "verse": 12
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-2-12"
        ]
      },
      {
        "textJa": "十二人がイシュ・ボシェテ側から出て、ダビデの家臣十二人と対しました。",
        "knownBy": {
          "chapter": 2,
          "verse": 15
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-2-15"
        ]
      },
      {
        "textJa": "イシュ・ボシェテはアブネルに、父サウルのそばめリツパとの関係を問いただしました。",
        "knownBy": {
          "chapter": 3,
          "verse": 7
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-3-7"
        ]
      },
      {
        "textJa": "アブネルはその問いに怒り、サウル家への忠誠を訴えました。",
        "knownBy": {
          "chapter": 3,
          "verse": 8
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-3-8"
        ]
      },
      {
        "textJa": "ダビデは使者を送り、ミカルをイシュ・ボシェテに返すよう求めました。",
        "knownBy": {
          "chapter": 3,
          "verse": 14
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-3-14"
        ]
      },
      {
        "textJa": "イシュ・ボシェテはミカルを夫パルティエルから迎えました。",
        "knownBy": {
          "chapter": 3,
          "verse": 15
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-3-15"
        ]
      },
      {
        "textJa": "レカブとバアナは、昼休み中のイシュ・ボシェテの家に入りました。",
        "knownBy": {
          "chapter": 4,
          "verse": 5
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-4-5"
        ]
      },
      {
        "textJa": "レカブとバアナはイシュ・ボシェテの首をヘブロンのダビデへ持って行きました。",
        "knownBy": {
          "chapter": 4,
          "verse": 8
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-4-8"
        ]
      },
      {
        "textJa": "イシュ・ボシェテの首はヘブロンでアブネルの墓に葬られました。",
        "knownBy": {
          "chapter": 4,
          "verse": 12
        },
        "sourceIds": [
          "person-ish-bosheth_622-webp-2sa-4-12"
        ]
      }
    ],
