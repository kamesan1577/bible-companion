    "facts": [
      {
        "textJa": "ダビデはサウルとヨナタンのために哀歌を歌います。",
        "knownBy": {
          "chapter": 1,
          "verse": 17
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-1-17"
        ]
      },
      {
        "textJa": "ダビデはヨナタンを「兄弟」と呼び、その愛情を語ります。",
        "knownBy": {
          "chapter": 1,
          "verse": 26
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-1-26"
        ]
      },
      {
        "textJa": "ヨナタンには足の不自由な息子メフィボシェトがいました。",
        "knownBy": {
          "chapter": 4,
          "verse": 4
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-4-4"
        ]
      },
      {
        "textJa": "ダビデはヨナタンのために、サウルの家の者に親切を示そうとします。",
        "knownBy": {
          "chapter": 9,
          "verse": 1
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-9-1"
        ]
      },
      {
        "textJa": "ザバはヨナタンに息子がいると告げます。",
        "knownBy": {
          "chapter": 9,
          "verse": 3
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-9-3"
        ]
      },
      {
        "textJa": "ダビデはヨナタンとの誓いのゆえに、ヨナタンの子メフィボシェトを助けます。",
        "knownBy": {
          "chapter": 21,
          "verse": 7
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-21-7"
        ]
      },
      {
        "textJa": "ダビデはヨナタンの遺骨をサウルの遺骨とともにヤベシュ・ギレアデから運び出します。",
        "knownBy": {
          "chapter": 21,
          "verse": 12
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-21-12"
        ]
      },
      {
        "textJa": "サウルとヨナタンの遺骨は、ベニヤミンの地のツェラにあるキシュの墓に葬られます。",
        "knownBy": {
          "chapter": 21,
          "verse": 14
        },
        "sourceIds": [
          "person-jonathan_1692-webp-2sa-21-14"
        ]
      }
    ],
