    "facts": [
      {
        "textJa": "ネレはアビエルの子と記されています。",
        "knownBy": {
          "chapter": 14,
          "verse": 51
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-14-51"
        ]
      },
      {
        "textJa": "サウルがアブネルにダビデの父を尋ねると、アブネルは知らないと答えます。",
        "knownBy": {
          "chapter": 17,
          "verse": 55
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-17-55"
        ]
      },
      {
        "textJa": "アブネルはダビデをサウルの前に連れて行きます。",
        "knownBy": {
          "chapter": 17,
          "verse": 57
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-17-57"
        ]
      },
      {
        "textJa": "王の食卓で、アブネルはサウルのそばに座ります。",
        "knownBy": {
          "chapter": 20,
          "verse": 25
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-20-25"
        ]
      },
      {
        "textJa": "サウルの陣では、アブネルが軍の長として人々の中にいます。",
        "knownBy": {
          "chapter": 26,
          "verse": 5
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-26-5"
        ]
      },
      {
        "textJa": "ダビデの呼びかけにアブネルは応答します。",
        "knownBy": {
          "chapter": 26,
          "verse": 14
        },
        "sourceIds": [
          "person-abner_57-webp-1sa-26-14"
        ]
      },
      {
        "textJa": "ダビデはアブネルに王の警護を問います。",
        "knownBy": {
          "chapter": 26,
          "verse": 15
        },
        "sourceIds": [
