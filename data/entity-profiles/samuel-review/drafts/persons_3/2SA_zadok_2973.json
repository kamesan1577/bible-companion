    "facts": [
      {
        "textJa": "ザドクは契約の箱を担うレビ人たちとともに現れます。",
        "knownBy": {
          "chapter": 15,
          "verse": 24
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-15-24"
        ]
      },
      {
        "textJa": "ダビデはザドクに、契約の箱を町へ戻すよう命じます。",
        "knownBy": {
          "chapter": 15,
          "verse": 25
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-15-25"
        ]
      },
      {
        "textJa": "ダビデはザドクに、祭司として町に戻るよう告げます。",
        "knownBy": {
          "chapter": 15,
          "verse": 27
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-15-27"
        ]
      },
      {
        "textJa": "ザドクとアビヤタルは契約の箱をエルサレムへ戻します。",
        "knownBy": {
          "chapter": 15,
          "verse": 29
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-15-29"
        ]
      },
      {
        "textJa": "フシャイはザドクとアビヤタルに、アヒトフェルの助言について知らせます。",
        "knownBy": {
          "chapter": 17,
          "verse": 15
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-17-15"
        ]
      },
      {
        "textJa": "ダビデはザドクとアビヤタルに、ユダの長老たちへ伝言を送ります。",
        "knownBy": {
          "chapter": 19,
          "verse": 11
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-19-11"
        ]
      },
      {
        "textJa": "本文はザドクとアビヤタルを祭司として記します。",
        "knownBy": {
          "chapter": 20,
          "verse": 25
        },
        "sourceIds": [
          "person-zadok_2973-webp-2sa-20-25"
        ]
      }
    ],
