    "facts": [
      {
        "textJa": "ユダの人々はベゼクで三万人と数えられ、イスラエルの三十万人と別に記されます。",
        "knownBy": {
          "chapter": 11,
          "verse": 8
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-11-8"
        ]
      },
      {
        "textJa": "サウルの招集では、ユダの人々は歩兵二十万人の別枠で数えられます。",
        "knownBy": {
          "chapter": 15,
          "verse": 4
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-15-4"
        ]
      },
      {
        "textJa": "ソコはユダに属する土地として記されます。",
        "knownBy": {
          "chapter": 17,
          "verse": 1
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-17-1"
        ]
      },
      {
        "textJa": "イスラエルとユダの人々はダビデを愛したと記されます。",
        "knownBy": {
          "chapter": 18,
          "verse": 16
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-18-16"
        ]
      },
      {
        "textJa": "ガドはダビデにユダの地へ行くよう告げます。",
        "knownBy": {
          "chapter": 22,
          "verse": 5
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-22-5"
        ]
      },
      {
        "textJa": "アキシュはツィクラグをユダの王たちに属する町として説明します。",
        "knownBy": {
          "chapter": 27,
          "verse": 6
        },
        "sourceIds": [
          "person-judah_1751-webp-1sa-27-6"
        ]
      }
    ],
