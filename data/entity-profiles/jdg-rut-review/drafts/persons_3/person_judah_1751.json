    "facts": [
      {
        "textJa": "1章3節でユダはシメオンに協力を求め、互いの割当地で共に戦おうと申し出ます。",
        "knownBy": {
          "chapter": 1,
          "verse": 3
        },
        "sourceIds": [
          "webp-jdg-1-3"
        ]
      },
      {
        "textJa": "1章8節ではユダの人々がエルサレムと戦い、町を取って火を放ちます。",
        "knownBy": {
          "chapter": 1,
          "verse": 8
        },
        "sourceIds": [
          "webp-jdg-1-8"
        ]
      },
      {
        "textJa": "1章9節でユダの人々は山地、南部、低地のカナン人と戦いに向かいます。",
        "knownBy": {
          "chapter": 1,
          "verse": 9
        },
        "sourceIds": [
          "webp-jdg-1-9"
        ]
      },
      {
        "textJa": "1章10節は、ユダがヘブロンのカナン人と戦い、シェシャイ、アヒマン、タルマイを打ったと記します。",
        "knownBy": {
          "chapter": 1,
          "verse": 10
        },
        "sourceIds": [
          "webp-jdg-1-10"
        ]
      },
      {
        "textJa": "1章17節でユダとシメオンはゼファテのカナン人を打ち、その町をヘルマと呼びます。",
        "knownBy": {
          "chapter": 1,
          "verse": 17
        },
        "sourceIds": [
          "webp-jdg-1-17"
        ]
      },
      {
        "textJa": "1章18節でユダはガザ、アシュケロン、エクロンとそれぞれの領域を取ります。",
        "knownBy": {
          "chapter": 1,
          "verse": 18
        },
        "sourceIds": [
          "webp-jdg-1-18"
        ]
      },
      {
        "textJa": "1章19節は、ユダが山地の住民を追い出した一方、鉄の戦車を持つ低地の住民を追い出せなかったと記します。",
        "knownBy": {
          "chapter": 1,
          "verse": 19
        },
        "sourceIds": [
          "webp-jdg-1-19"
        ]
      },
      {
        "textJa": "10章9節では、アンモン人がユダ、ベニヤミン、エフライムの家に戦いを仕掛けます。",
        "knownBy": {
          "chapter": 10,
          "verse": 9
        },
        "sourceIds": [
          "webp-jdg-10-9"
        ]
      },
      {
        "textJa": "15章9–11節で、ユダの人々はサムソンを縛るために来たペリシテ人と話し、サムソンのもとへ向かいます。",
        "knownBy": {
          "chapter": 15,
          "verse": 11
        },
        "sourceIds": [
          "webp-jdg-15-11"
        ]
      },
      {
        "textJa": "17章7節は、ベツレヘム・ユダ出身でユダの氏族に属する若いレビ人について述べます。",
        "knownBy": {
          "chapter": 17,
          "verse": 7
        },
        "sourceIds": [
          "webp-jdg-17-7"
        ]
      },
      {
        "textJa": "20章18節でイスラエルの人々が最初に戦う部族を尋ねると、主は「ユダが先」と答えます。",
        "knownBy": {
          "chapter": 20,
          "verse": 18
        },
        "sourceIds": [
          "webp-jdg-20-18"
        ]
      }
    ],
