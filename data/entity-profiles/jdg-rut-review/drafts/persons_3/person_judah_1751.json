  "review": {
    "book": "JDG",
    "entityID": "person:judah_1751",
    "primaryWitnessVersion": "webp-usfx-2026-10-13-35a6adf626e5",
    "primaryWitnesses": [
      {
        "ref": "JDG 1:2",
        "url": "https://ebible.org/engwebp/JDG01.htm#V2",
        "textualBasisJa": "The LORD said, “Judah shall go up. Behold, I have delivered the land into his hand.”"
      },
      {
        "ref": "JDG 1:3",
        "url": "https://ebible.org/engwebp/JDG01.htm#V3",
        "textualBasisJa": "Judah said to Simeon his brother, “Come up with me into my lot, that we may fight against the Canaanites; and I likewise will go with you into your lot.” So Simeon went with him."
      },
      {
        "ref": "JDG 1:4",
        "url": "https://ebible.org/engwebp/JDG01.htm#V4",
        "textualBasisJa": "Judah went up, and the LORD delivered the Canaanites and the Perizzites into their hand. They struck ten thousand men in Bezek."
      },
      {
        "ref": "JDG 1:8",
        "url": "https://ebible.org/engwebp/JDG01.htm#V8",
        "textualBasisJa": "The children of Judah fought against Jerusalem, took it, struck it with the edge of the sword, and set the city on fire."
      },
      {
        "ref": "JDG 1:9",
        "url": "https://ebible.org/engwebp/JDG01.htm#V9",
        "textualBasisJa": "After that, the children of Judah went down to fight against the Canaanites who lived in the hill country, and in the South, and in the lowland."
      },
      {
        "ref": "JDG 1:10",
        "url": "https://ebible.org/engwebp/JDG01.htm#V10",
        "textualBasisJa": "Judah went against the Canaanites who lived in Hebron. (The name of Hebron before that was Kiriath Arba.) They struck Sheshai, Ahiman, and Talmai."
      },
      {
        "ref": "JDG 1:16",
        "url": "https://ebible.org/engwebp/JDG01.htm#V16",
        "textualBasisJa": "The children of the Kenite, Moses’ brother-in-law, went up out of the city of palm trees with the children of Judah into the wilderness of Judah, which is in the south of Arad; and they went and lived with the people."
      },
      {
        "ref": "JDG 1:17",
        "url": "https://ebible.org/engwebp/JDG01.htm#V17",
        "textualBasisJa": "Judah went with Simeon his brother, and they struck the Canaanites who inhabited Zephath, and utterly destroyed it. The name of the city was called Hormah."
      },
      {
        "ref": "JDG 1:18",
        "url": "https://ebible.org/engwebp/JDG01.htm#V18",
        "textualBasisJa": "Also Judah took Gaza with its border, and Ashkelon with its border, and Ekron with its border."
      },
      {
        "ref": "JDG 1:19",
        "url": "https://ebible.org/engwebp/JDG01.htm#V19",
        "textualBasisJa": "The LORD was with Judah, and drove out the inhabitants of the hill country; for he could not drive out the inhabitants of the valley, because they had chariots of iron."
      },
      {
        "ref": "JDG 10:9",
        "url": "https://ebible.org/engwebp/JDG10.htm#V9",
        "textualBasisJa": "The children of Ammon passed over the Jordan to fight also against Judah, and against Benjamin, and against the house of Ephraim, so that Israel was very distressed."
      },
      {
        "ref": "JDG 15:9",
        "url": "https://ebible.org/engwebp/JDG15.htm#V9",
        "textualBasisJa": "Then the Philistines went up, encamped in Judah, and spread themselves in Lehi."
      },
      {
        "ref": "JDG 15:10",
        "url": "https://ebible.org/engwebp/JDG15.htm#V10",
        "textualBasisJa": "The men of Judah said, “Why have you come up against us?” They said, “We have come up to bind Samson, to do to him as he has done to us.”"
      },
      {
        "ref": "JDG 15:11",
        "url": "https://ebible.org/engwebp/JDG15.htm#V11",
        "textualBasisJa": "Then three thousand men of Judah went down to the cave in Etam’s rock, and said to Samson, “Don’t you know that the Philistines are rulers over us? What then is this that you have done to us?” He said to them, “As they did to me, so I have done to them.”"
      },
      {
        "ref": "JDG 17:7",
        "url": "https://ebible.org/engwebp/JDG17.htm#V7",
        "textualBasisJa": "There was a young man out of Bethlehem Judah, of the family of Judah, who was a Levite; and he lived there."
      },
      {
        "ref": "JDG 20:18",
        "url": "https://ebible.org/engwebp/JDG20.htm#V18",
        "textualBasisJa": "The children of Israel arose, went up to Bethel, and asked counsel of God. They asked, “Who shall go up for us first to battle against the children of Benjamin?” The LORD said, “Judah first.”"
      }
    ],
