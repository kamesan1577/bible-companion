    "facts": [
      {
        "textJa": "ゼブルはガアルの発言を聞いて怒りました。",
        "knownBy": {
          "chapter": 9,
          "verse": 30
        },
        "sourceIds": [
          "webp-jdg-9-30"
        ]
      },
      {
        "textJa": "ゼブルはアビメレクへ使者を送り、ガアルと兄弟らがシェケムに来て町を動かしていると告げました。",
        "knownBy": {
          "chapter": 9,
          "verse": 31
        },
        "sourceIds": [
          "webp-jdg-9-31"
        ]
      },
      {
        "textJa": "ガアルは町の門に出ました。人影を見た後、山から人々が下って来るとゼブルに告げます。",
        "knownBy": {
          "chapter": 9,
          "verse": 36
        },
        "sourceIds": [
          "webp-jdg-9-35",
          "webp-jdg-9-36"
        ]
      },
      {
        "textJa": "ガアルは続けて、人々が土地の中央から来るのを見たと述べました。",
        "knownBy": {
          "chapter": 9,
          "verse": 37
        },
        "sourceIds": [
          "webp-jdg-9-37"
        ]
      },
      {
        "textJa": "ガアルはシェケムの人々の前に出てアビメレクと戦いました。",
        "knownBy": {
          "chapter": 9,
          "verse": 39
        },
        "sourceIds": [
          "webp-jdg-9-39"
        ]
      },
      {
        "textJa": "アビメレクがアルマに住む間に、ゼブルはガアルとその兄弟たちをシェケムから追い出しました。",
        "knownBy": {
          "chapter": 9,
          "verse": 41
        },
        "sourceIds": [
          "webp-jdg-9-41"
        ]
      }
    ],
