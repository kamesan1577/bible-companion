    "facts": [
      {
        "textJa": "ナオミは、苦しみを語って自分を「マラ」と呼ぶよう求めました。",
        "knownBy": {
          "chapter": 1,
          "verse": 20
        },
        "sourceIds": [
          "webp-rut-1-20"
        ]
      },
      {
        "textJa": "ナオミはルツとともにモアブからベツレヘムへ戻り、大麦の刈り入れの初めに到着しました。",
        "knownBy": {
          "chapter": 1,
          "verse": 22
        },
        "sourceIds": [
          "webp-rut-1-22"
        ]
      },
      {
        "textJa": "ボアズが夫の近親者だと知ったナオミは、主が慈しみを絶やさなかったと語ります。",
        "knownBy": {
          "chapter": 2,
          "verse": 20
        },
        "sourceIds": [
          "webp-rut-2-20"
        ]
      },
      {
        "textJa": "ナオミはルツに、安らぎを得られるよう手立てを考えたいと話します。",
        "knownBy": {
          "chapter": 3,
          "verse": 1
        },
        "sourceIds": [
          "webp-rut-3-1"
        ]
      },
      {
        "textJa": "ナオミは生まれた子を胸に抱き、世話をしました。",
        "knownBy": {
          "chapter": 4,
          "verse": 16
        },
        "sourceIds": [
          "webp-rut-4-16"
        ]
      },
      {
        "textJa": "近隣の女性たちは、その子をオベデと名づけ、ナオミに生まれた子と呼びました。",
        "knownBy": {
          "chapter": 4,
          "verse": 17
        },
        "sourceIds": [
          "webp-rut-4-17"
        ]
      }
    ],
