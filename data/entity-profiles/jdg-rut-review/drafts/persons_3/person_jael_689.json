    "facts": [
      {
        "textJa": "4章18節でヤエルはシセラを天幕に招き、敷物で覆います。",
        "knownBy": {
          "chapter": 4,
          "verse": 18
        },
        "sourceIds": [
          "webp-jdg-4-18"
        ]
      },
      {
        "textJa": "4章21節では、眠ったシセラをヤエルが天幕の杭で打ち、彼は死にます。",
        "knownBy": {
          "chapter": 4,
          "verse": 21
        },
        "sourceIds": [
          "webp-jdg-4-21"
        ]
      },
      {
        "textJa": "4章22節でヤエルは追ってきたバラクにシセラを見せます。",
        "knownBy": {
          "chapter": 4,
          "verse": 22
        },
        "sourceIds": [
          "webp-jdg-4-22"
        ]
      },
      {
        "textJa": "5章6節はヤエルの時代に街道が使われず、旅人が脇道を通ったと歌います。",
        "knownBy": {
          "chapter": 5,
          "verse": 6
        },
        "sourceIds": [
          "webp-jdg-5-6"
        ]
      },
      {
        "textJa": "5章24節はヤエルを女性たちの中で祝福される者として歌います。",
        "knownBy": {
          "chapter": 5,
          "verse": 24
        },
        "sourceIds": [
          "webp-jdg-5-24"
        ]
      }
    ],
