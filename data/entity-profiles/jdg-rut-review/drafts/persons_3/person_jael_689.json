      {
        "ref": "JDG 5:6",
        "url": "https://ebible.org/engwebp/JDG05.htm#V6",
        "textualBasisJa": "“In the days of Shamgar the son of Anath, in the days of Jael, the highways were unoccupied. The travelers walked through byways."
