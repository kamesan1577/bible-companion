    "facts": [
      {
        "textJa": "アモリ人はヘレス山、アヤロン、シャアルビムに住み、後にヨセフ族の勢力下で労役を負います。",
        "knownBy": {
          "chapter": 1,
          "verse": 35
        },
        "sourceIds": [
          "amorite_237-webp-jdg-1-35"
        ]
      },
      {
        "textJa": "士師記1:36は、アモリ人の境界をアクラビムの坂、セラから上方へと記します。",
        "knownBy": {
          "chapter": 1,
          "verse": 36
        },
        "sourceIds": [
          "amorite_237-webp-jdg-1-36"
        ]
      },
      {
        "textJa": "イスラエルの民はカナン人、ヒッタイト人、アモリ人などの諸集団の中に住みます。",
        "knownBy": {
          "chapter": 3,
          "verse": 5
        },
        "sourceIds": [
          "amorite_237-webp-jdg-3-5"
        ]
      },
      {
        "textJa": "預言者の言葉は、民が住むアモリ人の地の神々を恐れないよう告げたと回想します。",
        "knownBy": {
          "chapter": 6,
          "verse": 10
        },
        "sourceIds": [
          "amorite_237-webp-jdg-6-10"
        ]
      },
      {
        "textJa": "士師記10:8は、ギレアデのアモリ人の地に住むイスラエル人が十八年間圧迫されたと述べます。",
        "knownBy": {
          "chapter": 10,
          "verse": 8
        },
        "sourceIds": [
          "amorite_237-webp-jdg-10-8"
        ]
      },
      {
        "textJa": "主はイスラエルに、アモリ人などから救ったことを思い起こさせます。",
        "knownBy": {
          "chapter": 10,
          "verse": 11
        },
        "sourceIds": [
          "amorite_237-webp-jdg-10-11"
        ]
      },
      {
        "textJa": "イスラエルはアモリ人の王シホンに使者を送り、領内通過を求めます。",
        "knownBy": {
          "chapter": 11,
          "verse": 19
        },
        "sourceIds": [
          "amorite_237-webp-jdg-11-19"
        ]
      },
      {
        "textJa": "主がシホンとその民をイスラエルの手に渡し、彼らはその地を占有します。",
        "knownBy": {
          "chapter": 11,
          "verse": 21
        },
        "sourceIds": [
          "amorite_237-webp-jdg-11-21"
        ]
      },
      {
        "textJa": "エフタの語りは、アモリ人の境界をアルノン川からヤボク川、荒野からヨルダン川までと述べます。",
        "knownBy": {
          "chapter": 11,
          "verse": 22
        },
        "sourceIds": [
          "amorite_237-webp-jdg-11-22"
        ]
      },
      {
        "textJa": "エフタは主がアモリ人をイスラエルの前から追い払ったと論じます。",
        "knownBy": {
          "chapter": 11,
          "verse": 23
        },
        "sourceIds": [
          "amorite_237-webp-jdg-11-23"
        ]
      }
    ],
