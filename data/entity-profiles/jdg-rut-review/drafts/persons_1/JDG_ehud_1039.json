    "facts": [
      {
        "textJa": "エフドは両刃の剣を作り、衣服の下の右腿に帯びます。",
        "knownBy": {
          "chapter": 3,
          "verse": 16
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-16"
        ]
      },
      {
        "textJa": "貢ぎ物を差し出し終えると、エフドは運搬人たちを帰します。",
        "knownBy": {
          "chapter": 3,
          "verse": 18
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-18"
        ]
      },
      {
        "textJa": "エフドはエグロンに神からの伝言があると告げます。",
        "knownBy": {
          "chapter": 3,
          "verse": 20
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-20"
        ]
      },
      {
        "textJa": "エフドは左手で剣を取り、エグロンを刺します。",
        "knownBy": {
          "chapter": 3,
          "verse": 21
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-21"
        ]
      },
      {
        "textJa": "エフドは上の間から出て、戸を閉じます。",
        "knownBy": {
          "chapter": 3,
          "verse": 23
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-23"
        ]
      },
      {
        "textJa": "エフドは待つ者たちを避けて逃れ、セイラへ向かいます。",
        "knownBy": {
          "chapter": 3,
          "verse": 26
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-3-26"
        ]
      },
      {
        "textJa": "本文は、エフドの死後にイスラエルの民が再び主の前に悪を行ったと記します。",
        "knownBy": {
          "chapter": 4,
          "verse": 1
        },
        "sourceIds": [
          "ehud_1039-webp-jdg-4-1"
        ]
      }
    ],
