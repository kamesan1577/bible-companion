    "primaryWitnesses": [
      {
        "ref": "JDG 3:15",
        "textualBasisJa": "But when the children of Israel cried to the LORD, the LORD raised up a savior for them: Ehud the son of Gera, the Benjamite, a left-handed man. The children of Israel sent tribute by him to Eglon the king of Moab."
      },
      {
        "ref": "JDG 3:16",
        "textualBasisJa": "Ehud made himself a sword which had two edges, a cubit in length; and he wore it under his clothing on his right thigh."
      },
      {
        "ref": "JDG 3:18",
        "textualBasisJa": "When Ehud had finished offering the tribute, he sent away the people who carried the tribute."
      },
      {
        "ref": "JDG 3:20",
        "textualBasisJa": "Ehud came to him; and he was sitting by himself alone in the cool upper room. Ehud said, “I have a message from God to you.” He arose out of his seat."
      },
      {
        "ref": "JDG 3:21",
        "textualBasisJa": "Ehud put out his left hand, and took the sword from his right thigh, and thrust it into his body."
      },
      {
        "ref": "JDG 3:23",
        "textualBasisJa": "Then Ehud went out onto the porch, and shut the doors of the upper room on him, and locked them."
      },
      {
        "ref": "JDG 3:26",
        "textualBasisJa": "Ehud escaped while they waited, passed beyond the stone idols, and escaped to Seirah."
      },
      {
        "ref": "JDG 4:1",
        "textualBasisJa": "The children of Israel again did that which was evil in the LORD’s sight, when Ehud was dead."
      }
    ],
