    "primaryWitnesses": [
      {
        "ref": "JDG 1:1",
        "textualBasisJa": "After the death of Joshua, the children of Israel asked of the LORD, saying, “Who should go up for us first against the Canaanites, to fight against them?”"
      },
      {
        "ref": "JDG 2:6",
        "textualBasisJa": "Now when Joshua had sent the people away, the children of Israel each went to his inheritance to possess the land."
      },
      {
        "ref": "JDG 2:7",
        "textualBasisJa": "The people served the LORD all the days of Joshua, and all the days of the elders who outlived Joshua, who had seen all the great work of the LORD that he had worked for Israel."
      },
      {
        "ref": "JDG 2:8",
        "textualBasisJa": "Joshua the son of Nun, the servant of the LORD, died, being one hundred ten years old."
      },
      {
        "ref": "JDG 2:21",
        "textualBasisJa": "I also will no longer drive out any of the nations that Joshua left when he died from before them;"
      },
      {
        "ref": "JDG 2:23",
        "textualBasisJa": "So the LORD left those nations, without driving them out hastily. He didn’t deliver them into Joshua’s hand."
      }
    ],
