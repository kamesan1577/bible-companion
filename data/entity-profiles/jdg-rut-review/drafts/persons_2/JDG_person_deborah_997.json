    "facts": [
      {
        "textJa": "デボラはラマとベテルの間にあるデボラのなつめやしの木の下でイスラエルを裁きました。",
        "knownBy": {
          "chapter": 4,
          "verse": 5
        },
        "sourceIds": [
          "person-deborah-997-webp-4-5"
        ]
      },
      {
        "textJa": "デボラはバラクを呼び、ケデシュから来るよう告げます。",
        "knownBy": {
          "chapter": 4,
          "verse": 6
        },
        "sourceIds": [
          "person-deborah-997-webp-4-5",
          "person-deborah-997-webp-4-6"
        ]
      },
      {
        "textJa": "デボラはバラクとともにケデシュへ行くことを約束し、シセラに勝利する誉れが女性に帰すると告げます。",
        "knownBy": {
          "chapter": 4,
          "verse": 9
        },
        "sourceIds": [
          "person-deborah-997-webp-4-9",
          "person-deborah-997-webp-4-7"
        ]
      },
      {
        "textJa": "デボラとバラクは勝利の日に歌い、彼女はイスラエルの母として自らを表します。",
        "knownBy": {
          "chapter": 5,
          "verse": 1
        },
        "sourceIds": [
          "person-deborah-997-webp-5-1"
        ]
      }
    ],
