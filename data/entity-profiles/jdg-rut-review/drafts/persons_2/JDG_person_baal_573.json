    "facts": [
      {
        "textJa": "イスラエルはバアルとアシュタロテに仕えたと記されます。",
        "knownBy": {
          "chapter": 2,
          "verse": 13
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-2-13"
        ]
      },
      {
        "textJa": "イスラエルはバアルたちとアシュタロテに仕えたと記されます。",
        "knownBy": {
          "chapter": 3,
          "verse": 7
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-3-7"
        ]
      },
      {
        "textJa": "主はギデオンに、父のバアルの祭壇を壊し、その傍らのアシェラを切り倒すよう命じます。",
        "knownBy": {
          "chapter": 6,
          "verse": 25
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-6-25"
        ]
      },
      {
        "textJa": "町の人々は祭壇が壊されたことを問題にし、ヨアシュは「もし神なら自分で争うはずだ」と応じます。その日にギデオンは「バアルは争え」との意味を持つ名で呼ばれます。",
        "knownBy": {
          "chapter": 6,
          "verse": 32
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-6-32"
        ]
      },
      {
        "textJa": "ギデオンの死後、イスラエルはバアルたちに従ったと記されます。",
        "knownBy": {
          "chapter": 8,
          "verse": 33
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-8-33"
        ]
      },
      {
        "textJa": "イスラエルはバアルたちに仕えたと記されます。",
        "knownBy": {
          "chapter": 10,
          "verse": 6
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-10-6"
        ]
      },
      {
        "textJa": "イスラエルは主に、自分たちがバアルたちに仕えたことを告白します。",
        "knownBy": {
          "chapter": 10,
          "verse": 10
        },
        "sourceIds": [
          "JDG-person-baal-573-webp-10-10"
        ]
      }
    ],
