    "facts": [
      {
        "textJa": "サムソンはティムナへ下り、そこでペリシテ人の女性を見ました。",
        "knownBy": {
          "chapter": 14,
          "verse": 1
        },
        "sourceIds": [
          "person-samson-2468-webp-14-1"
        ]
      },
      {
        "textJa": "サムソンはその女性を妻にするよう父母に求め、ペリシテ人との婚姻を問われると、彼女を気に入ったと答えました。",
        "knownBy": {
          "chapter": 14,
          "verse": 3
        },
        "sourceIds": [
          "person-samson-2468-webp-14-3"
        ]
      },
      {
        "textJa": "サムソンはペリシテ人を害することについて、自分は責任を負わないと述べました。",
        "knownBy": {
          "chapter": 15,
          "verse": 3
        },
        "sourceIds": [
          "person-samson-2468-webp-15-3"
        ]
      },
      {
        "textJa": "サムソンはペリシテ人の仕打ちへの報復を告げました。",
        "knownBy": {
          "chapter": 15,
          "verse": 7
        },
        "sourceIds": [
          "person-samson-2468-webp-15-7"
        ]
      },
      {
        "textJa": "デリラに髪をそられ、主が彼から離れた後、ペリシテ人に捕らえられます。",
        "knownBy": {
          "chapter": 16,
          "verse": 20
        },
        "sourceIds": [
          "person-samson-2468-webp-16-14",
          "person-samson-2468-webp-16-20"
        ]
      },
      {
        "textJa": "サムソンは最後に主に力を求め、建物を崩して多くのペリシテ人とともに死にました。",
        "knownBy": {
          "chapter": 16,
          "verse": 30
        },
        "sourceIds": [
          "person-samson-2468-webp-16-28",
          "person-samson-2468-webp-16-30"
        ]
      }
    ],
