    "facts": [
      {
        "textJa": "ミカの家には彫像、エフォド、テラフィムがあり、彼は息子の一人を祭司に任じました。",
        "knownBy": {
          "chapter": 17,
          "verse": 5
        },
        "sourceIds": [
          "person-micah-2049-webp-17-4",
          "person-micah-2049-webp-17-5"
        ]
      },
      {
        "textJa": "ミカは旅の途中のレビ人を家に迎え、祭司として雇いました。",
        "knownBy": {
          "chapter": 17,
          "verse": 12
        },
        "sourceIds": [
          "person-micah-2049-webp-17-8",
          "person-micah-2049-webp-17-12"
        ]
      },
      {
        "textJa": "ダンの人々が礼拝具と祭司を連れ去り、ミカは追いかけましたが、彼らの力に及ばず家へ戻りました。",
        "knownBy": {
          "chapter": 18,
          "verse": 26
        },
