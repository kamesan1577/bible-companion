    "facts": [
      {
        "textJa": "異母兄弟たちはエフタを家から追い出し、彼はトブの地に住みました。",
        "knownBy": {
          "chapter": 11,
          "verse": 3
        },
        "sourceIds": [
          "person-jephthah-839-webp-11-2",
          "person-jephthah-839-webp-11-3"
        ]
      },
      {
        "textJa": "ギレアドの長老たちはエフタを呼びに行き、アンモン人との戦いの指導者になってほしいと求めます。",
        "knownBy": {
          "chapter": 11,
          "verse": 6
        },
        "sourceIds": [
          "person-jephthah-839-webp-11-5",
          "person-jephthah-839-webp-11-6"
        ]
      },
      {
        "textJa": "エフタの娘が父のもとへ戻ると、父は誓ったとおりに彼女にしました。本文は彼女が処女であったことを記し、後代の意味づけを確定する説明は加えていません。",
        "knownBy": {
          "chapter": 11,
          "verse": 39
        },
        "sourceIds": [
          "person-jephthah-839-webp-11-39"
        ]
      },
      {
        "textJa": "エフタはイスラエルを六年間裁き、ギレアドの町に葬られたと記されます。",
        "knownBy": {
          "chapter": 12,
          "verse": 7
        },
        "sourceIds": [
          "person-jephthah-839-webp-12-7"
        ]
      },
      {
        "textJa": "イスラエルの娘たちは年ごとに四日間、エフタの娘を悼む習わしを持ったと記されます。",
        "knownBy": {
          "chapter": 11,
          "verse": 40
        },
        "sourceIds": [
          "person-jephthah-839-webp-11-40"
        ]
      }
    ],
