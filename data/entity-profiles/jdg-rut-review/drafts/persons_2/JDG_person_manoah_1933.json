    "facts": [
      {
        "textJa": "マノアは、生まれる子をどう育てるべきか教えてほしいと主に願いました。",
        "knownBy": {
          "chapter": 13,
          "verse": 8
        },
        "sourceIds": [
          "person-manoah-1933-webp-13-8"
        ]
      },
      {
        "textJa": "神はマノアの願いを聞き、神の使いは再びその妻のもとに現れました。",
        "knownBy": {
          "chapter": 13,
          "verse": 9
        },
        "sourceIds": [
          "person-manoah-1933-webp-13-9"
        ]
      },
      {
        "textJa": "妻とともに主の使いを迎え、子が生まれた後にサムソンと名付けられたと記されます。",
        "knownBy": {
          "chapter": 13,
          "verse": 24
        },
        "sourceIds": [
          "person-manoah-1933-webp-13-19",
          "person-manoah-1933-webp-13-24"
        ]
      },
      {
        "textJa": "サムソンの死後、マノアの墓に葬られたと記されます。",
        "knownBy": {
          "chapter": 16,
          "verse": 31
        },
        "sourceIds": [
          "person-manoah-1933-webp-16-31"
        ]
      }
    ],
