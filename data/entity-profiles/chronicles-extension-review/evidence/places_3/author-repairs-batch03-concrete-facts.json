    {
      "draftPath": "drafts/places_3/2CH_holy_place_575.json",
      "entityID": "place:holy_place_575",
      "field": "profile.summaryJa",
      "knownBy": {
        "chapter": 5,
        "verse": 11
      },
      "sourceID": "webp-2ch-5-11",
      "fixedWEBText": "When the priests had come out of the holy place (for all the priests who were present had sanctified themselves, and didn’t keep their divisions;",
      "beforeTextJa": "神殿を主のために聖別する命令や祭具の運搬に関連して、「聖なる場所」が言及されます。至聖所という別の内室と区別して扱います。",
      "afterTextJa": "神殿奉献の場面で、祭司たちが聖所から出てきたと記されます。",
      "newDraftSHA256": "0b3b2b654f4a5408f8b547e140e0c4a23b240066876551f2824cdd6071586d61",
      "newProfileSHA256": "d821a50ca02557266acef7a4cbb5cd0999f17173e9c0c5ff6946cc4abebf8a0b",
      "newEvidenceSHA256": "cad7d55bcce5171cc8ea23e855ef9d3db26bbf64924e10c47f5439d5292c4f65",
      "rationaleJa": "初出の5:11で分かる祭司が聖所から出た場面に要約を限定し、29章以後の清めや奉仕の情報を常時表示から外した。"
    },
    {
      "draftPath": "drafts/places_3/2CH_shephelah_1074.json",
      "entityID": "place:shephelah_1074",
      "field": "profile.facts[1].textJa",
      "knownBy": {
        "chapter": 26,
        "verse": 10
      },
      "sourceID": "webp-2ch-26-10",
      "fixedWEBText": "He built towers in the wilderness, and dug out many cisterns, for he had much livestock, both in the lowlands and in the plains. He had farmers and vineyard keepers in the mountains and in the fruitful fields, for he loved farming.",
      "beforeTextJa": "ウジヤは家畜を多く持ち、低地や平地に水槽を掘り、山地や肥沃な畑では農夫やぶどう栽培者を置いたと記されます。「低地」が特定のシェフェラを指すとは本文だけでは確定できません。",
      "afterTextJa": "ウジヤは荒野に塔を築き、多くの水槽を掘り、低地や平地に多くの家畜を持ったと記されます。山地や肥沃な畑には農夫とぶどう栽培者を置いたとも述べます。本文は「低地」をシェフェラと明示していません。",
      "preservedBeforeDraftSHA256": "2609cfa776cea7ae7b4d326eaf7890aeceb7f921991f4c8809bb78595bfc542c",
      "preservedBeforeDraftPath": "preservation/objects/2609cfa776cea7ae7b4d326eaf7890aeceb7f921991f4c8809bb78595bfc542c",
      "newDraftSHA256": "d33f2420f7a3a73c2deaf0fa3f61055230bfd542b09274198d79e25b877c9fc6",
      "newEvidenceSHA256": "84cb9c13cb3968eaebddde218ec5d27bedeb728c81997c1cacc7b3cc01339c14",
      "rationaleJa": "低地や平地は家畜の飼育範囲で、水槽の位置とは書かれていないため、荒野の塔・水槽と牧畜地を文法どおり分けた。低地をシェフェラと特定しない留保を残した。"
    },
    {
      "draftPath": "drafts/places_3/2CH_shephelah_1074.json",
      "entityID": "place:shephelah_1074",
      "field": "profile.facts[0].textJa",
      "knownBy": {
        "chapter": 9,
        "verse": 27
      },
      "sourceID": "webp-2ch-9-27",
      "fixedWEBText": "The king made silver as common in Jerusalem as stones, and he made cedars to be as abundant as the sycamore trees that are in the lowland.",
      "beforeTextJa": "低地ではシカモアの木が多く、銀が石のようにありふれていたことにたとえて、杉も豊富だったと記されます。この節の「低地」はシェフェラと特定されていません。",
      "afterTextJa": "エルサレムでは銀が石のように、杉は低地のシカモアのように豊富だったと記されています。この節の「低地」はシェフェラと特定されていません。",
      "preservedBeforeDraftSHA256": "d33f2420f7a3a73c2deaf0fa3f61055230bfd542b09274198d79e25b877c9fc6",
      "preservedBeforeDraftPath": "preservation/objects/d33f2420f7a3a73c2deaf0fa3f61055230bfd542b09274198d79e25b877c9fc6",
      "newDraftSHA256": "601b62011065278c6dfa08c4cf4ec67986969d9b8811d1f9d91a99c9e3c1711a",
      "newEvidenceSHA256": "dd5fc6927831c982d7a63920704190ebcb351738da5bb8042b5bbdcacc04ea34",
      "rationaleJa": "固定本文の比較対象を文法どおり明確にし、「低地」を特定地域シェフェラへ同定しない留保を残した。"
    }
