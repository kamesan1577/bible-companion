          "canonical": {
            "book": "2CH",
            "chapter": 21,
            "verse": 8
          },
          "text": "In his days Edom revolted from under the hand of Judah, and made a king over themselves.",
          "textStatus": "present",
          "citationURL": "https://ebible.org/engwebp/2CH21.htm#V8",
