    "primaryWitnesses": [
      {
        "ref": "2CH 32:1",
        "textualBasisJa": "After these things and this faithfulness, Sennacherib king of Assyria came, entered into Judah, encamped against the fortified cities, and intended to win them for himself."
      },
      {
        "ref": "2CH 32:2",
        "textualBasisJa": "When Hezekiah saw that Sennacherib had come, and that he was planning to fight against Jerusalem,"
      },
      {
        "ref": "2CH 32:9",
        "textualBasisJa": "After this, Sennacherib king of Assyria sent his servants to Jerusalem, (now he was attacking Lachish, and all his forces were with him), to Hezekiah king of Judah, and to all Judah who were at Jerusalem, saying,"
      },
      {
        "ref": "2CH 32:10",
        "textualBasisJa": "Sennacherib king of Assyria says, “In whom do you trust, that you remain under siege in Jerusalem?"
      },
      {
        "ref": "2CH 32:22",
        "textualBasisJa": "Thus the LORD saved Hezekiah and the inhabitants of Jerusalem from the hand of Sennacherib the king of Assyria and from the hand of all others, and guided them on every side."
      }
    ],
