    "facts": [
      {
        "textJa": "ヒゼキヤはセンナケリブがエルサレムと戦う計画を知りました。",
        "knownBy": {
          "chapter": 32,
          "verse": 2
        },
        "sourceIds": [
          "sennacherib_2489-webp-2ch-32-2"
        ]
      },
      {
        "textJa": "ラキシュ攻略中、センナケリブは使者をエルサレムのヒゼキヤへ送りました。",
        "knownBy": {
          "chapter": 32,
          "verse": 9
        },
        "sourceIds": [
          "sennacherib_2489-webp-2ch-32-9"
        ]
      },
      {
        "textJa": "センナケリブは包囲下の人々に、誰を信頼しているのかと問いました。",
        "knownBy": {
          "chapter": 32,
          "verse": 10
        },
        "sourceIds": [
          "sennacherib_2489-webp-2ch-32-10"
        ]
      },
      {
        "textJa": "主がヒゼキヤとエルサレムの住民をセンナケリブから救ったと記されています。",
