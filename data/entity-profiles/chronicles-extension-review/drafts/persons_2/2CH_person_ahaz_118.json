    "facts": [
      {
        "textJa": "アハズは二十歳で王となり、エルサレムで十六年間治めたと記されています。",
        "knownBy": {
          "chapter": 28,
          "verse": 1
        },
        "sourceIds": [
          "chronicles-batch08-2ch-ahaz_118-28-1"
        ]
      },
      {
        "textJa": "アハズはアッシリアの王たちへ援助を求めます。",
        "knownBy": {
          "chapter": 28,
          "verse": 16
        },
        "sourceIds": [
          "chronicles-batch08-2ch-ahaz_118-28-16"
        ]
      },
      {
        "textJa": "神殿の器物を壊し、主の家の扉を閉じたと記されています。",
        "knownBy": {
          "chapter": 28,
          "verse": 24
        },
        "sourceIds": [
          "chronicles-batch08-2ch-ahaz_118-28-24"
        ]
      },
      {
        "textJa": "アハズの死後、息子ヒゼキヤが王位を継ぎます。",
        "knownBy": {
          "chapter": 28,
          "verse": 27
        },
        "sourceIds": [
          "chronicles-batch08-2ch-ahaz_118-28-27"
        ]
      }
