    "facts": [
      {
        "textJa": "ヨシヤは八歳で王となり、エルサレムで三十一年間治めたと記されます。",
        "knownBy": {
          "chapter": 34,
          "verse": 1
        },
        "sourceIds": [
          "chronicles-batch09-2ch-josiah_1730-34-1"
        ]
      },
      {
        "textJa": "ヨシヤは宗教改革を進め、神殿修理と過越祭の記述に登場します。",
        "knownBy": {
          "chapter": 34,
          "verse": 8
        },
        "sourceIds": [
          "chronicles-batch09-2ch-josiah_1730-34-8"
        ]
      },
      {
        "textJa": "ヨシヤはネコの言葉を聞かず、変装してメギドの谷で戦いました。",
        "knownBy": {
          "chapter": 35,
          "verse": 22
        },
        "sourceIds": [
          "chronicles-batch09-2ch-josiah_1730-35-22"
        ]
      },
      {
        "textJa": "ヨシヤの死をエレミヤが嘆き、歌い手たちの哀歌も記されます。",
        "knownBy": {
          "chapter": 35,
          "verse": 25
        },
        "sourceIds": [
          "chronicles-batch09-2ch-josiah_1730-35-25"
        ]
      }
    ],
