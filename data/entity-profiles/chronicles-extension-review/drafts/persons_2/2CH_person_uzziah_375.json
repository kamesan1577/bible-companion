    "facts": [
      {
        "textJa": "ウジヤは十六歳で王となり、エルサレムで五十二年間治めたと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 3
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-3"
        ]
      },
      {
        "textJa": "アモン人が彼に貢ぎ、名声と勢力が広がったと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 8
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-8"
        ]
      },
      {
        "textJa": "エルサレムの城門や城壁の塔を建て、町を補強したと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 9
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-9"
        ]
      },
      {
        "textJa": "軍勢は部隊ごとに出陣し、書記官と役人がその人数を記録しました。",
        "knownBy": {
          "chapter": 26,
          "verse": 11
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-11"
        ]
      },
      {
        "textJa": "祭司たちは香をたくのは祭司の役目だとウジヤを制止しました。",
        "knownBy": {
          "chapter": 26,
          "verse": 18
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-18"
        ]
      },
      {
        "textJa": "彼が怒ったとき、額に皮膚病が現れたと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 19
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-19"
        ]
      },
      {
        "textJa": "死ぬまで皮膚病を患い、ヨタムが王宮を管理して民を裁いたと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 21
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-21"
        ]
      },
      {
        "textJa": "イザヤがウジヤの事績を記したと述べられます。",
        "knownBy": {
          "chapter": 26,
          "verse": 22
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-22"
        ]
      },
      {
        "textJa": "ウジヤは死に、息子ヨタムが後を継いだと記されます。",
        "knownBy": {
          "chapter": 26,
          "verse": 23
        },
        "sourceIds": [
          "chronicles-batch09-2ch-uzziah_375-26-23"
        ]
      }
    ],
