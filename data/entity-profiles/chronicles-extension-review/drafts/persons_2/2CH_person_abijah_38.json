    "facts": [
      {
        "textJa": "レハブアムはアビヤを兄弟たちの長に任じ、王位を継がせる意図を示します。",
        "knownBy": {
          "chapter": 11,
          "verse": 22
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-11-22"
        ]
      },
      {
        "textJa": "レハブアムの死後、アビヤが王位を継ぎます。",
        "knownBy": {
          "chapter": 12,
          "verse": 16
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-12-16"
        ]
      },
      {
        "textJa": "ヤロブアムの治世第十八年に、アビヤはユダの王となります。",
        "knownBy": {
          "chapter": 13,
          "verse": 1
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-13-1"
        ]
      },
      {
        "textJa": "アビヤは四十万人を率い、ヤロブアムの軍と対峙します。",
        "knownBy": {
          "chapter": 13,
          "verse": 3
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-13-3"
        ]
      },
      {
        "textJa": "戦いの後、アビヤとその軍はイスラエル軍に大きな損害を与えたと記されています。",
        "knownBy": {
          "chapter": 13,
          "verse": 17
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-13-17"
        ]
      },
      {
        "textJa": "アビヤには二十二人の息子と十六人の娘がいたと記されています。",
        "knownBy": {
          "chapter": 13,
          "verse": 21
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-13-21"
        ]
      },
      {
        "textJa": "アビヤの死後、息子アサが王位を継ぎます。",
        "knownBy": {
          "chapter": 14,
          "verse": 1
        },
        "sourceIds": [
          "chronicles-batch08-2ch-abijah_38-14-1"
        ]
      }
    ],
