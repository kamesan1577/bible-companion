{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "paths": {
      "@bible/core": [
        "./packages/core/src/index.ts"
      ],
      "@bible/ai-harness": [
        "./packages/ai-harness/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}
